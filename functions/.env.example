# Copy to functions/.env for local emulator runs. Do not commit functions/.env.
# Production: set via Firebase params / deploy environment (defaults are safe).

# Shop password reset — MUST stay false in production.
SHOP_PASSWORD_RESET_DEBUG=false

# Server-side key for getDrivingRoute / geocodePlace (mapsProxy.ts) — used
# by Flutter web, which can't call Google's Directions/Geocoding REST APIs
# directly (no CORS headers on those endpoints). Needs Directions API and
# Geocoding API enabled; no application restriction (server calls only).
GOOGLE_MAPS_KEY=

# SMSlenz phone OTP (live sender_id: MN Delivery)
# Do NOT put SMSLENZ_API_KEY in .env for production deploy — it conflicts with
# Secret Manager. Set the secret instead:
#   firebase functions:secrets:set SMSLENZ_API_KEY
# Local emulator: put SMSLENZ_API_KEY in .secret.local only.
SMSLENZ_USER_ID=2317
SMSLENZ_SENDER_ID=MN Delivery

# Required for paymentWebhook (also set via:
#   firebase functions:secrets:set PAYMENT_WEBHOOK_SECRET)
# PAYMENT_WEBHOOK_SECRET=

# PayHere merchant config (rides + orders checkout, payHereNotify webhook).
# PayHere issues a separate Merchant Secret per registered domain/app
# (Integrations tab) — not one secret per account — so two are needed:
#   PAYHERE_MERCHANT_SECRET        — the "Mobile App" entry (native SDK
#                                    checkout on Android/iOS).
#   PAYHERE_DOMAIN_MERCHANT_SECRET — the "Domain" entry registered for the
#                                    PAYHERE_CHECKOUT_PAGE_URL host below.
#                                    Used by payHereCheckoutPage, the
#                                    self-submitting checkout form loaded by
#                                    both the web browser redirect and every
#                                    mobile app's in-app WebView (rides),
#                                    since both present as that one domain's
#                                    origin to PayHere.
# payHereNotify verifies incoming webhook signatures against both secrets
# (a transaction may have been signed with either, depending on which
# integration initiated it) and accepts whichever matches.
# PAYHERE_MERCHANT_ID=
# PAYHERE_MERCHANT_SECRET=
# PAYHERE_DOMAIN_MERCHANT_SECRET=
# PAYHERE_MODE=sandbox
# PAYHERE_CHECKOUT_PAGE_URL=https://mnd.lk/payhere-checkout