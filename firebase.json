{
  "firestore": {
    "rules": "mnd_customer/firestore.rules",
    "indexes": "mnd_customer/firestore.indexes.json"
  },
  "storage": {
    "rules": "mnd_customer/storage.rules"
  },
  "functions": [
    {
      "source": "functions",
      "codebase": "default",
      "predeploy": ["npm --prefix \"$RESOURCE_DIR\" run build"],
      "ignore": [
        "node_modules",
        ".git",
        "firebase-debug.log",
        "firebase-debug.*.log",
        "*.local"
      ]
    }
  ]
}
