rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }

    function isSelf(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    function userDoc() {
      return get(/databases/$(database)/documents/customers/$(request.auth.uid));
    }

    function userDocExists() {
      return exists(/databases/$(database)/documents/customers/$(request.auth.uid));
    }

    function vendorSelfDoc() {
      return get(/databases/$(database)/documents/vendors/$(request.auth.uid));
    }

    function vendorSelfDocExists() {
      return exists(/databases/$(database)/documents/vendors/$(request.auth.uid));
    }

    function riderSelfDocExists() {
      return isSignedIn()
        && exists(/databases/$(database)/documents/riders/$(request.auth.uid));
    }

    function riderSelfDoc() {
      return get(/databases/$(database)/documents/riders/$(request.auth.uid));
    }

    function riderIsApproved() {
      return riderSelfDocExists()
        && riderSelfDoc().data.status is string
        && (riderSelfDoc().data.status == 'approved'
          || riderSelfDoc().data.status == 'active');
    }

    /// Rider is holding more collected cash than platform_config/fees allows.
    /// Server-maintained on the rider doc (riderCash.ts) — riders can't write
    /// it, since every self-update path is a hasOnly() whitelist that omits
    /// it. Read off riderSelfDoc(), which claim rules already fetch, so this
    /// gate costs no extra document read.
    function riderCashHoldActive() {
      return riderSelfDocExists()
        && riderSelfDoc().data.get('cashHoldActive', false) == true;
    }

    function riderStatusUnchanged() {
      return request.resource.data.status == resource.data.get('status', 'pending');
    }

    function userRole() {
      return !isSignedIn()
        ? null
        : (userDocExists() && 'role' in userDoc().data && userDoc().data.role is string
            ? userDoc().data.role
            : (vendorSelfDocExists()
                && 'role' in vendorSelfDoc().data
                && vendorSelfDoc().data.role is string
                ? vendorSelfDoc().data.role
                : null));
    }

    /// Matches Console / imports where role casing varies (Admin, ADMIN).
    function isAdmin() {
      let r = userRole();
      return r == 'admin' || r == 'Admin' || r == 'ADMIN';
    }

    function riderVehicleMatchesTripVehicle(tripVehicle) {
      let rv = riderSelfDoc().data.vehicleType;
      return (tripVehicle == 'bike' && rv == 'bike')
        || (tripVehicle == 'car' && (rv == 'car' || rv == 'van'))
        || (tripVehicle == 'wheel'
          && (rv == 'three_wheeler' || rv == 'wheel'));
    }

    function isRider() {
      return riderSelfDocExists();
    }

    function isVendor() {
      let r = userRole();
      return r == 'vendor' || r == 'Vendor' || r == 'VENDOR';
    }

    // Vendors scoped to their Firestore store id (must match orders.vendorId and vendors/{id}).
    function vendorStoreId() {
      return (userDocExists()
          && 'vendorStoreId' in userDoc().data
          && userDoc().data.vendorStoreId is string)
        ? userDoc().data.vendorStoreId
        : ((vendorSelfDocExists()
              && 'vendorStoreId' in vendorSelfDoc().data
              && vendorSelfDoc().data.vendorStoreId is string)
            ? vendorSelfDoc().data.vendorStoreId
            : '');
    }

    /// Canonical store id on an order: [vendorId] (primary) or [vendorStoreId] (alias — same value as vendors doc id / profile vendorStoreId).
    function orderVendorStoreKey() {
      let o = resource.data;
      return ('vendorId' in o && o.vendorId is string && o.vendorId.size() > 0)
        ? o.vendorId
        : (
            ('vendorStoreId' in o && o.vendorStoreId is string && o.vendorStoreId.size() > 0)
              ? o.vendorStoreId
              : ''
          );
    }

    /// [orderVendorStoreKey] maps to vendors/{id}; allow if that storefront belongs to this auth user.
    function vendorOrderStorefrontOwnedByAuth() {
      let vid = orderVendorStoreKey();
      let vpath = /databases/$(database)/documents/vendors/$(vid);
      return isSignedIn()
        && vid is string
        && vid.size() > 0
        && vid.size() <= 128
        && exists(vpath)
        && (
          vid == request.auth.uid
          || (
            'uid' in get(vpath).data
            && get(vpath).data.uid is string
            && get(vpath).data.uid == request.auth.uid
          )
        );
    }

    function vendorMayAccessThisOrder() {
      return orderVendorStoreKey().size() > 0
        && orderVendorStoreKey().size() <= 128
        && (
          vendorOrderStorefrontOwnedByAuth()
          ||
          // Profile vendorStoreId on customers/ or vendors/{auth} must match order store key.
          ((isVendor() || exists(/databases/$(database)/documents/vendors/$(request.auth.uid)))
            && vendorStoreId().size() > 0
            && orderVendorStoreKey() == vendorStoreId())
        );
    }

    // User profile: owner can read/update own profile (customers, riders, admins; legacy vendors).
    // Shop app self-register uses [vendors] only — see validSelfServeVendorCreate.
    match /customers/{uid} {
      allow read: if isSelf(uid) || isAdmin();

      function validVendorUserCreate() {
        let d = request.resource.data;
        return d.uid == request.auth.uid
          && d.role == 'vendor'
          && d.vendorStoreId is string
          && d.vendorStoreId == request.auth.uid
          && d.vendorStoreId.size() > 0
          && d.vendorStoreId.size() <= 128
          && d.displayName is string
          && d.displayName.size() > 0
          && d.displayName.size() <= 120
          && (!('email' in d) || (d.email is string && d.email.size() <= 200))
          && (!('phoneNumber' in d) || (d.phoneNumber is string && d.phoneNumber.size() <= 32));
      }

      // Job posting membership credits — customers must not self-grant on create.
      function noSelfGrantedJobCreditsOnCreate() {
        let d = request.resource.data;
        return (!('jobPostCredits' in d) || d.jobPostCredits == 0)
          && !('jobPostCreditsUpdatedAt' in d)
          && !('jobPostCreditsUpdatedBy' in d);
      }

      // Self may leave credits untouched, or decrement by exactly 1 (job submit).
      function validSelfJobCreditChange() {
        let affected = request.resource.data.diff(resource.data).affectedKeys();
        let creditKeys = ['jobPostCredits', 'jobPostCreditsUpdatedAt', 'jobPostCreditsUpdatedBy'];
        let touchesCredits = affected.hasAny(creditKeys);
        let oldCredits = resource.data.get('jobPostCredits', 0);
        let newCredits = request.resource.data.get('jobPostCredits', -1);
        return !touchesCredits
          || (
            !affected.hasAny(['jobPostCreditsUpdatedBy'])
            && affected.hasOnly(['jobPostCredits', 'jobPostCreditsUpdatedAt'])
            && newCredits is number
            && oldCredits is number
            && newCredits == oldCredits - 1
            && newCredits >= 0
          )
          || (
            !affected.hasAny(['jobPostCreditsUpdatedBy'])
            && affected.hasOnly(['jobPostCredits'])
            && newCredits is number
            && oldCredits is number
            && newCredits == oldCredits - 1
            && newCredits >= 0
          );
      }

      function validSelfCustomerUpdate() {
        return isSelf(uid)
          && request.resource.data.uid == resource.data.uid
          && request.resource.data.role == resource.data.role
          // vendorStoreId is admin-managed: self-updates must not re-point the
          // profile at another vendor's store (order/store access is derived from it).
          && !request.resource.data.diff(resource.data).affectedKeys()
            .hasAny(['vendorStoreId'])
          && validSelfJobCreditChange();
      }

      allow create: if isSelf(uid)
        && request.resource.data.uid == request.auth.uid
        && noSelfGrantedJobCreditsOnCreate()
        && (request.resource.data.role == 'customer'
          || (request.resource.data.role == 'vendor' && validVendorUserCreate()));

      allow update: if isAdmin() || validSelfCustomerUpdate();

      // Self-delete supports Play Store account-deletion requirement.
      allow delete: if isAdmin() || isSelf(uid);

      match /saved_addresses/{addressId} {
        function validSavedAddress() {
          let data = request.resource.data;
          return data.label is string
            && data.label.size() > 0
            && data.label.size() <= 48
            && data.line1 is string
            && data.line1.size() > 0
            && data.line1.size() <= 200
            && data.line2 is string
            && data.line2.size() <= 200
            && data.city is string
            && data.city.size() > 0
            && data.city.size() <= 80
            && data.phone is string
            && data.phone.size() >= 8
            && data.phone.size() <= 20
            && data.isDefault is bool;
        }

        allow read: if isSelf(uid);

        allow create: if isSelf(uid) && validSavedAddress();

        allow update: if isSelf(uid) && validSavedAddress();

        allow delete: if isSelf(uid);
      }
    }

    // Catalog read is public so the customer app can show real Firestore data while
    // browsing (including guest mode). Do not store secrets (raw FCM tokens, private
    // notes) on this document — prefer customers/{uid} / Admin-only fields.
    match /vendors/{vendorId} {
      allow read: if true;

      function validSelfServeVendorCreate() {
        let d = request.resource.data;
        return d.uid == request.auth.uid
          && d.role == 'vendor'
          && d.vendorStoreId is string
          && d.vendorStoreId == request.auth.uid
          && d.vendorStoreId.size() > 0
          && d.vendorStoreId.size() <= 128
          && d.name is string
          && d.name.size() > 0
          && d.name.size() <= 120
          && (!('description' in d) || (d.description is string && d.description.size() <= 200))
          && d.active is bool
          && d.active == false
          && 'approvalStatus' in d
          && d.approvalStatus is string
          && d.approvalStatus == 'pending'
          && (!('email' in d) || (d.email is string && d.email.size() <= 200));
      }

      /// Non-admin vendors cannot publish (`active: true`) or change approval until `approvalStatus` is `approved`.
      /// (Firestore rules functions cannot use `if` — use ternary / boolean logic only.)
      function vendorOwnVendorDocUpdateOk() {
        let b = resource.data;
        let a = request.resource.data;
        // Legacy docs without approvalStatus: owner may keep updating (open/close),
        // but cannot self-add an approvalStatus string (admin grants approval).
        let approvalOk = (!('approvalStatus' in b) || !(b.approvalStatus is string))
          ? (!('approvalStatus' in a) || !(a.approvalStatus is string))
          : (
              b.approvalStatus == 'approved'
                ? (!('approvalStatus' in a) || a.approvalStatus == 'approved')
                : (a.active == false && (!('approvalStatus' in a) || a.approvalStatus == b.approvalStatus))
            );
        // rating / ratingCount are owned by Cloud Functions (store_ratings aggregation).
        let ratingFieldsUnchanged = !a.diff(b).affectedKeys()
          .hasAny(['rating', 'ratingCount']);
        // Identity fields are frozen: userRole() falls back to vendors/{uid}.role,
        // so an unlocked role would let a vendor self-escalate to admin, and an
        // unlocked vendorStoreId would let it claim another vendor's store.
        let identityFieldsUnchanged = !a.diff(b).affectedKeys()
          .hasAny(['role', 'uid', 'vendorStoreId']);
        return approvalOk && ratingFieldsUnchanged && identityFieldsUnchanged;
      }

      function vendorNonAdminStoreOwner(vendorId) {
        return isSignedIn() && (
          vendorId == request.auth.uid
          || (isVendor() && vendorStoreId().size() > 0 && vendorId == vendorStoreId())
        );
      }

      // New shop: single vendors/{authUid} doc (shop app registration; no customers/{uid} row required).
      // Non-admin creates are limited to the caller's own doc id with pending/inactive
      // content — a vendor must not be able to mint arbitrary storefront docs.
      allow create: if isAdmin()
        || (isSignedIn() && vendorId == request.auth.uid && validSelfServeVendorCreate());
      // Own doc id (self-register) OR profile-linked store id (legacy slug doc).
      allow update: if isAdmin()
        || (vendorNonAdminStoreOwner(vendorId) && vendorOwnVendorDocUpdateOk());
      allow delete: if isAdmin()
        || vendorNonAdminStoreOwner(vendorId);

      match /notifications/{notificationId} {
        function validRiderVendorNotificationCreate() {
          let n = request.resource.data;
          return isRider()
            && n.orderId is string
            && n.orderId.size() > 0
            && n.type is string
            && n.type == 'rider_accepted'
            && n.title is string
            && n.title.size() > 0
            && n.title.size() <= 120
            && n.body is string
            && n.body.size() > 0
            && n.body.size() <= 500
            && n.createdAt is timestamp
            && (!('read' in n) || n.read is bool);
        }

        allow read: if isSignedIn()
          && (vendorNonAdminStoreOwner(vendorId) || isAdmin());
        allow create: if isAdmin() || validRiderVendorNotificationCreate();
        allow update: if isSignedIn()
          && vendorNonAdminStoreOwner(vendorId)
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['read', 'readAt']);
        allow delete: if isAdmin();
      }

      // Platform fee invoices: shop may read own history; only admin writes.
      match /monthly_invoices/{monthKey} {
        allow read: if isSignedIn()
          && (vendorNonAdminStoreOwner(vendorId) || isAdmin());
        allow create, update, delete: if isAdmin();
      }
    }

    // Admin web billing / fee config (mnd_web). Any signed-in user may read —
    // the customer app needs `fees` (delivery curve, service charge %) for
    // checkout previews, same pattern as ride_fare_config below. Writes stay
    // admin-only.
    match /platform_config/{docId} {
      allow read: if isSignedIn();
      allow create, update, delete: if isAdmin();
    }

    // Products: public read for storefront; writes restricted.
    // Writes: admin, or the store owner (storeId == auth uid). Shop app ties storeId to uid;
    // do not rely only on customers/{uid}.role == 'vendor' (missing/out-of-sync profile caused
    // permission-denied on product create).
    match /products/{productId} {
      allow read: if true;

      function ownsProductStoreOnWrite() {
        return isSignedIn()
          && request.resource.data.keys().hasAll(['storeId'])
          && request.resource.data.storeId is string
          && request.resource.data.storeId == request.auth.uid;
      }

      function ownsProductStoreOnReadDoc() {
        return isSignedIn()
          && resource.data.keys().hasAll(['storeId'])
          && resource.data.storeId is string
          && resource.data.storeId == request.auth.uid;
      }

      function productStoreIdUnchanged() {
        return request.resource.data.storeId == resource.data.storeId;
      }

      // A vendor write is otherwise unrestricted map-level access — this
      // closes the specific gap where stockQty could be set negative or
      // non-numeric (manageStock then trusts it directly for the
      // customer-side "sold out" check), without guessing a full field
      // allowlist across both the food and grocery product shapes.
      function validProductStockFields() {
        let o = request.resource.data;
        return (!('stockQty' in o) || (o.stockQty is int && o.stockQty >= 0))
          && (!('manageStock' in o) || o.manageStock is bool);
      }

      allow create: if isAdmin()
        || (ownsProductStoreOnWrite() && validProductStockFields());

      allow update: if isAdmin()
        || (ownsProductStoreOnReadDoc()
          && productStoreIdUnchanged()
          && validProductStockFields());

      allow delete: if isAdmin() || ownsProductStoreOnReadDoc();
    }

    // Home promo banners: public read; admin manages writes.
    match /banners/{bannerId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    // App version gate (doc id per app: customer/rider/shop) — public read so
    // signed-out screens (splash/login) can prompt too; admin edits from console.
    match /app_config/{appId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    // Standalone shop offers: approved docs are public; vendors see own history;
    // vendors create as pending only; admin approves/rejects.
    match /offers/{offerId} {
      function ownsOfferStoreOnWrite() {
        return isSignedIn()
          && request.resource.data.keys().hasAll(['storeId'])
          && request.resource.data.storeId is string
          && request.resource.data.storeId == request.auth.uid;
      }

      function ownsOfferStoreOnReadDoc() {
        return isSignedIn()
          && resource.data.keys().hasAll(['storeId'])
          && resource.data.storeId is string
          && resource.data.storeId == request.auth.uid;
      }

      function offerStoreIdUnchanged() {
        return request.resource.data.storeId == resource.data.storeId;
      }

      function validOfferCreate() {
        let d = request.resource.data;
        return d.keys().hasAll([
              'storeId', 'storeName', 'title', 'imageUrl', 'priceLkr',
              'endsAt', 'status', 'order', 'createdBy', 'createdAt', 'updatedAt'
            ])
          && d.storeId is string
          && d.storeId.size() > 0
          && d.storeName is string
          && d.title is string
          && d.title.size() > 0
          && d.title.size() <= 120
          && d.imageUrl is string
          && d.imageUrl.size() > 0
          && d.priceLkr is int
          && d.priceLkr >= 0
          && d.endsAt is timestamp
          && d.status == 'pending'
          && (d.order is int || d.order is float || d.order is number)
          && d.createdBy is string
          && d.createdBy == request.auth.uid;
      }

      allow read: if resource.data.status == 'approved'
        || isAdmin()
        || ownsOfferStoreOnReadDoc();

      allow create: if isAdmin()
        || (ownsOfferStoreOnWrite() && validOfferCreate());

      // Vendor may edit own pending/rejected offers only (cannot demote approved).
      allow update: if isAdmin()
        || (ownsOfferStoreOnReadDoc()
            && offerStoreIdUnchanged()
            && resource.data.status in ['pending', 'rejected']
            && request.resource.data.status in ['pending', 'rejected']);

      allow delete: if isAdmin()
        || (ownsOfferStoreOnReadDoc() && resource.data.status == 'pending');
    }

    // Broad vendor categories (Food, Grocery). Shop app reads without auth.
    match /shop_categories/{categoryId} {
      allow read: if true;

      function validShopCategoryDoc() {
        let d = request.resource.data;
        let orderOk = d.order is int || d.order is float || d.order is number;
        return d.label is string
          && d.label.size() > 0
          && d.label.size() <= 80
          && orderOk
          && d.active is bool
          // Explicit food/grocery flag the shop app can key off instead of
          // parsing the label text — optional so legacy docs stay valid.
          && (!('isGrocery' in d) || d.isGrocery is bool);
      }

      allow create: if isAdmin() && validShopCategoryDoc();
      allow update: if isAdmin() && validShopCategoryDoc();
      allow delete: if isAdmin();
    }

    // Specific shop kinds under a shop_categories doc (`categoryId`). Public read.
    match /shop_types/{typeId} {
      allow read: if true;

      function validShopTypeDoc() {
        let d = request.resource.data;
        let orderOk = d.order is int || d.order is float || d.order is number;
        return d.label is string
          && d.label.size() > 0
          && d.label.size() <= 80
          && orderOk
          && d.active is bool
          && d.categoryId is string
          && d.categoryId.size() > 0
          && d.categoryId.size() <= 128;
      }

      allow create: if isAdmin() && validShopTypeDoc();
      allow update: if isAdmin() && validShopTypeDoc();
      allow delete: if isAdmin();
    }

    // Grocery product aisles (Dairy, Snacks, …). Shop + customer apps read without auth.
    match /grocery_aisles/{aisleId} {
      allow read: if true;

      function validGroceryAisleDoc() {
        let d = request.resource.data;
        let orderOk = d.order is int || d.order is float || d.order is number;
        return d.label is string
          && d.label.size() > 0
          && d.label.size() <= 80
          && orderOk
          && d.active is bool;
      }

      allow create: if isAdmin() && validGroceryAisleDoc();
      allow update: if isAdmin() && validGroceryAisleDoc();
      allow delete: if isAdmin();
    }

    // -------------------------------------------------------------------------
    // Riders (MND Rider app) — profile, earnings subcollections, inbox
    // -------------------------------------------------------------------------
    match /riders/{riderId} {
      // PII (NIC, phone, doc URLs). Live map uses `rider_locations/{id}` instead.
      function canReadRiderDoc() {
        return isSelf(riderId) || isAdmin();
      }

      function riderDocIsApproved() {
        return resource.data.status is string
          && (resource.data.status == 'approved' || resource.data.status == 'active');
      }

      // Custom-token OTP sign-in may omit phone_number on the first ID token.
      // `verifiedPhone` is set on the custom token in verifyPhoneOtp, bound to
      // the exact number that OTP proved — unlike a bare boolean, it can't be
      // satisfied by claiming a *different* phone in the document.
      function riderPhoneClaimMatches(d) {
        return (request.auth.token.phone_number is string
            && request.auth.token.phone_number == d.phone)
          || (request.auth.token.verifiedPhone is string
              && request.auth.token.verifiedPhone == d.phone);
      }

      function validRiderRegistrationCreate() {
        let d = request.resource.data;
        return riderPhoneClaimMatches(d)
          && d.keys().hasOnly([
            'uid', 'fullName', 'phone', 'nicNumber',
            'profilePhotoUrl', 'licensePhotoUrl', 'licenseExpiresAt', 'vehiclePhotoUrl',
            'vehiclePhotos',
            'insurancePhotoUrl', 'insuranceExpiresAt',
            'revenueLicensePhotoUrl', 'revenueLicenseExpiresAt',
            'vehicleType', 'vehicleNumber', 'city', 'email',
            'role', 'status', 'online', 'registrationComplete', 'phoneVerified',
            'createdAt', 'updatedAt'
          ])
          && d.uid == riderId
          && d.role == 'rider'
          && d.status == 'pending'
          && d.online == false
          && d.registrationComplete == true
          && d.phoneVerified == true
          && d.fullName is string
          && d.fullName.size() >= 2
          && d.fullName.size() <= 120
          && d.phone is string
          && d.phone.size() >= 10
          && d.phone.size() <= 20
          && d.nicNumber is string
          && d.nicNumber.size() >= 9
          && d.nicNumber.size() <= 14
          && d.vehicleType is string
          && d.vehicleType in ['bike', 'three_wheeler', 'van', 'car']
          && d.vehicleNumber is string
          && d.vehicleNumber.size() >= 3
          && d.vehicleNumber.size() <= 20
          && d.city is string
          && d.city.size() >= 2
          && d.city.size() <= 80
          && (!('email' in d) || (d.email is string && d.email.size() <= 200))
          && d.profilePhotoUrl is string
          && d.licensePhotoUrl is string
          && d.licenseExpiresAt is timestamp
          && d.vehiclePhotoUrl is string
          && (!('vehiclePhotos' in d) || (
            d.vehiclePhotos is map
            && d.vehiclePhotos.keys().hasOnly(['front', 'back', 'left', 'right'])
            && d.vehiclePhotos.front is string
            && d.vehiclePhotos.back is string
            && d.vehiclePhotos.left is string
            && d.vehiclePhotos.right is string
          ))
          && d.insurancePhotoUrl is string
          && d.insuranceExpiresAt is timestamp
          && d.revenueLicensePhotoUrl is string
          && d.revenueLicenseExpiresAt is timestamp;
      }

      // Vehicle/license/insurance fields are compliance-sensitive: changing
      // any of them must re-flag the rider for admin review rather than
      // silently keeping an 'approved'/'active' status on unverified data.
      function riderComplianceKeys() {
        return [
          'vehicleType', 'vehicleNumber', 'licensePhotoUrl', 'licenseExpiresAt',
          'vehiclePhotoUrl',
          'vehiclePhotos', 'insurancePhotoUrl', 'insuranceExpiresAt',
          'revenueLicensePhotoUrl', 'revenueLicenseExpiresAt'
        ];
      }

      function riderProfilePatchTouchesCompliance() {
        return request.resource.data.diff(resource.data).affectedKeys()
          .hasAny(riderComplianceKeys());
      }

      function validRiderProfilePatch() {
        let c = request.resource.data.diff(resource.data).affectedKeys();
        // Phone / registrationComplete / email are not client-editable.
        return c.hasOnly([
            'fullName', 'nicNumber', 'city', 'vehicleType', 'vehicleNumber',
            'profilePhotoUrl', 'licensePhotoUrl', 'licenseExpiresAt', 'vehiclePhotoUrl',
            'vehiclePhotos',
            'insurancePhotoUrl', 'insuranceExpiresAt',
            'revenueLicensePhotoUrl', 'revenueLicenseExpiresAt', 'updatedAt',
            'status'
          ])
          // 'status' may only appear in the patch to self-demote to
          // 'pending', and only alongside a compliance-field change.
          && (!('status' in c) || (
            riderProfilePatchTouchesCompliance()
            && request.resource.data.status == 'pending'
          ))
          // Any compliance-field change must actually land the rider back
          // in 'pending' — an approved/active rider can't swap a vehicle,
          // license, or insurance doc and keep their approved status.
          && (!riderProfilePatchTouchesCompliance()
            || request.resource.data.status == 'pending');
      }

      function validRiderPresencePatch() {
        let c = request.resource.data.diff(resource.data).affectedKeys();
        let keysOk = c.hasOnly(['online', 'updatedAt'])
          || c.hasOnly(['online', 'locationUpdatedAt', 'updatedAt'])
          || c.hasOnly(['online', 'locationUpdatedAt']);
        // Pending riders may only go / stay offline; online requires approval.
        return keysOk
          && (
            request.resource.data.online == false
            || riderDocIsApproved()
          );
      }

      function validRiderLocationPatch() {
        let c = request.resource.data.diff(resource.data).affectedKeys();
        let keysOk = c.hasOnly([
            'currentLocation', 'latitude', 'longitude', 'heading', 'speed',
            'locationUpdatedAt', 'online', 'updatedAt'
          ])
          || c.hasOnly([
            'currentLocation', 'latitude', 'longitude', 'heading', 'speed',
            'locationUpdatedAt', 'online'
          ])
          || c.hasOnly([
            'currentLocation', 'latitude', 'longitude', 'heading', 'speed',
            'locationUpdatedAt', 'updatedAt'
          ])
          || c.hasOnly([
            'currentLocation', 'latitude', 'longitude', 'heading', 'speed',
            'locationUpdatedAt'
          ]);
        return keysOk
          && (
            !('online' in request.resource.data)
            || request.resource.data.online == resource.data.get('online', false)
            || request.resource.data.online == false
            || riderDocIsApproved()
          );
      }

      function validRiderFcmPatch() {
        let c = request.resource.data.diff(resource.data).affectedKeys();
        return c.hasOnly(['fcmToken', 'fcmTokenUpdatedAt', 'updatedAt']);
      }

      function validRiderPreferencesPatch() {
        let c = request.resource.data.diff(resource.data).affectedKeys();
        return c.hasOnly(['acceptsPassengerRides', 'updatedAt'])
          && (!('acceptsPassengerRides' in request.resource.data)
            || request.resource.data.acceptsPassengerRides is bool);
      }

      function validRiderSelfUpdate() {
        return request.resource.data.uid == resource.data.get('uid', riderId)
          && request.resource.data.role == resource.data.get('role', 'rider')
          && (
            // Profile patch owns its own status invariant (see
            // validRiderProfilePatch): unchanged, unless a compliance
            // field changed, in which case it must become 'pending'.
            validRiderProfilePatch()
            || (
              riderStatusUnchanged()
              && (
                validRiderPresencePatch()
                || validRiderLocationPatch()
                || validRiderFcmPatch()
                || validRiderPreferencesPatch()
              )
            )
          );
      }

      allow read: if canReadRiderDoc();
      allow create: if isAdmin()
        || (isSelf(riderId) && validRiderRegistrationCreate());
      // Incomplete riders may retry the full registration payload as an update
      // (OTP already created the Auth user; a stub/failed write may exist).
      allow update: if isAdmin()
        || (isSelf(riderId) && validRiderSelfUpdate())
        || (isSelf(riderId)
            && resource.data.get('registrationComplete', false) != true
            && validRiderRegistrationCreate());
      allow delete: if isAdmin();

      // Wallet balance is server-authoritative: credited by the
      // onOrderDeliveredCreditRider trigger and debited by the
      // requestRiderWithdrawal callable (Admin SDK, which bypasses rules).
      // Clients may only read — self-writes were a balance-inflation vector.
      match /wallet/{docId} {
        allow read: if isSelf(riderId) || isAdmin();
        allow write: if isAdmin();
      }

      // Written only by the delivery-credit Cloud Function (Admin SDK).
      match /earnings_aggregates/{periodKey} {
        allow read: if isSelf(riderId) || isAdmin();
        allow write: if isAdmin();
      }

      // Ledger is written server-side (delivery-credit trigger / withdrawal
      // callable). Clients read only so earnings cannot be fabricated.
      match /transactions/{transactionId} {
        allow read: if isSelf(riderId) || isAdmin();
        allow write: if isAdmin();
      }

      // Created only via the requestRiderWithdrawal callable (Admin SDK), which
      // verifies balance server-side. Admin settles status on payout.
      match /withdrawals/{withdrawalId} {
        allow read: if isSelf(riderId) || isAdmin();
        allow write: if isAdmin();
      }

      // Cash the rider collected but hasn't handed over. Written by the
      // earnings triggers and the settlement callables (Admin SDK); a rider
      // who could edit these could clear their own cash hold.
      match /cash_ledger/{entryId} {
        allow read: if isSelf(riderId) || isAdmin();
        allow write: if isAdmin();
      }

      // Handover requests. Created by riderRequestCashSettlement and closed by
      // adminConfirmCashSettlement / adminRejectCashSettlement.
      match /cash_settlements/{settlementId} {
        allow read: if isSelf(riderId) || isAdmin();
        allow write: if isAdmin();
      }

      match /notifications/{notificationId} {
        function validRiderInboxCreate() {
          return false;
        }

        allow read: if isSelf(riderId) || isAdmin();
        allow create: if isAdmin() || validRiderInboxCreate();
        allow update: if isSelf(riderId)
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['read']);
        allow delete: if isAdmin();
      }
    }

    // High-frequency GPS (recommended split from profile doc).
    match /rider_locations/{riderId} {
      function validRiderLocationDoc() {
        let d = request.resource.data;
        return d.riderId == riderId
          && d.latitude is number
          && d.longitude is number
          && d.location is latlng
          && d.online is bool
          && (
            !('vehicleType' in d)
            || (d.vehicleType is string && d.vehicleType in ['bike', 'wheel', 'car'])
          );
      }

      function validRiderLocationOnlineOnlyUpdate() {
        let c = request.resource.data.diff(resource.data).affectedKeys();
        return (
            c.hasOnly(['online', 'locationUpdatedAt'])
            || c.hasOnly(['online', 'locationUpdatedAt', 'vehicleType'])
            || c.hasOnly(['online', 'vehicleType'])
          )
          && request.resource.data.online is bool
          && request.resource.data.riderId == resource.data.riderId
          && (
            !('vehicleType' in request.resource.data)
            || (request.resource.data.vehicleType is string
              && request.resource.data.vehicleType in ['bike', 'wheel', 'car'])
          );
      }

      allow read: if isAdmin()
        || isSelf(riderId)
        || (isSignedIn() && resource.data.online == true);
      allow create: if isAdmin()
        || (isSelf(riderId) && riderIsApproved() && validRiderLocationDoc());
      allow update: if isAdmin()
        || (isSelf(riderId) && riderIsApproved() && (
          validRiderLocationDoc() || validRiderLocationOnlineOnlyUpdate()
        ));
      allow delete: if isAdmin();
    }

    // Orders: any signed-in user may create/read/update their own rows when customerId matches
    // auth uid (validOrderCreate already enforces that on create). Role in customers/{uid} is not
    // required — avoids permission-denied when profile/role is missing or vendor shops as buyer.
    // Rider/vendor/admin can read and update orders for operations.
    match /orders/{orderId} {
      function isAssignedRiderForOrder() {
        return isSignedIn()
          && (
            (resource.data.assignedRiderId is string && resource.data.assignedRiderId == request.auth.uid)
            || (resource.data.riderId is string && resource.data.riderId == request.auth.uid)
          );
      }

      function orderUnassignedForRiders() {
        return !('assignedRiderId' in resource.data)
          || resource.data.assignedRiderId == null
          || (resource.data.assignedRiderId is string
            && resource.data.assignedRiderId.size() == 0);
      }

      function orderOpenForRiderClaim() {
        return resource.data.status == 'ready'
          && resource.data.openForRiders == true
          && orderUnassignedForRiders();
      }

      function orderCoreFieldsUnchanged() {
        let o = request.resource.data;
        let r = resource.data;
        return o.customerId == r.customerId
          && o.vendorId == r.vendorId
          && o.get('vendorStoreId', r.get('vendorStoreId', ''))
            == r.get('vendorStoreId', '')
          && o.storeName == r.storeName
          && o.subtotal == r.subtotal
          && o.discount == r.discount
          && o.deliveryFee == r.deliveryFee
          && o.get('serviceCharge', r.get('serviceCharge', 0))
            == r.get('serviceCharge', 0)
          && o.total == r.total
          && o.items == r.items
          && o.paymentMethod == r.paymentMethod
          && o.get('productCashLkr', r.get('productCashLkr', 0))
            == r.get('productCashLkr', 0)
          && o.get('productCashStatus', r.get('productCashStatus', ''))
            == r.get('productCashStatus', '')
          && o.get('productCashRiderId', r.get('productCashRiderId', ''))
            == r.get('productCashRiderId', '');
      }

      function validRiderClaimOrder() {
        let o = request.resource.data;
        let c = o.diff(resource.data).affectedKeys();
        return isRider()
          && riderIsApproved()
          // Over the cash-in-hand limit: no new jobs until admin confirms a
          // handover. Deliberately absent from the progress rules below so a
          // rider who crosses the limit mid-delivery can still finish it.
          && !riderCashHoldActive()
          && orderOpenForRiderClaim()
          && orderCoreFieldsUnchanged()
          && o.assignedRiderId == request.auth.uid
          && o.riderId == request.auth.uid
          && o.openForRiders == false
          && o.status == 'out_for_delivery'
          && o.riderAcceptedAt is timestamp
          && c.hasOnly([
            'assignedRiderId', 'riderId', 'openForRiders', 'status',
            'riderAcceptedAt', 'riderStatusUpdatedAt',
            'pickupLatitude', 'pickupLongitude', 'pickupAddress'
          ]);
      }

      function riderDeliveryStatusTransitionOk(fromStatus, toStatus) {
        let from = fromStatus == null ? '' : fromStatus;
        return (from == 'out_for_delivery'
            && toStatus in ['picked_up', 'on_the_way', 'delivered'])
          || (from == 'picked_up' && toStatus in ['on_the_way', 'delivered'])
          || (from == 'on_the_way' && toStatus == 'delivered');
      }

      function validRiderAssignedOrderProgress() {
        let o = request.resource.data;
        let r = resource.data;
        let c = o.diff(r).affectedKeys();
        return isRider()
          && riderIsApproved()
          && isAssignedRiderForOrder()
          && o.riderId == r.riderId
          && o.assignedRiderId == r.assignedRiderId
          && orderCoreFieldsUnchanged()
          && o.openForRiders == false
          && o.status in ['picked_up', 'on_the_way', 'delivered']
          && riderDeliveryStatusTransitionOk(r.status, o.status)
          // actual_trip deliveries must be finalized by completeDeliveryOrder.
          && (o.status != 'delivered'
            || !('deliveryFeeMode' in r)
            || r.deliveryFeeMode != 'actual_trip')
          && c.hasOnly([
            'status', 'riderStatusUpdatedAt',
            'pickedUpAt', 'onTheWayAt', 'deliveredAt', 'updatedAt'
          ]);
      }

      function validAdminOrderCreate() {
        let o = request.resource.data;
        let addr = o.deliveryAddress;
        return o.customerId is string
          && o.customerId.size() > 0
          && o.customerId.size() <= 128
          && o.vendorId is string
          && o.vendorId.size() > 0
          && o.vendorId.size() <= 128
          && (!('vendorStoreId' in o)
            || (o.vendorStoreId is string
              && o.vendorStoreId.size() > 0
              && o.vendorStoreId.size() <= 128
              && o.vendorStoreId == o.vendorId))
          && o.storeName is string
          && o.storeName.size() > 0
          && o.storeName.size() <= 120
          && o.status is string
          && o.status.size() > 0
          && o.status.size() <= 32
          && o.paymentMethod is string
          && o.paymentMethod.size() > 0
          && o.paymentMethod.size() <= 32
          && o.items is list
          && o.items.size() > 0
          && o.items.size() <= 50
          && o.subtotal is int
          && o.subtotal >= 0
          && o.discount is int
          && o.discount >= 0
          && o.deliveryFee is int
          && o.deliveryFee >= 0
          && (!('serviceCharge' in o)
            || (o.serviceCharge is int && o.serviceCharge >= 0))
          && o.total is int
          && o.total >= 0
          && o.deliveryNote is string
          && o.deliveryNote.size() <= 500
          && o.specialInstructions is string
          && o.specialInstructions.size() <= 500
          && addr is map
          && addr.line1 is string
          && addr.line1.size() > 0
          && addr.line1.size() <= 200
          && addr.line2 is string
          && addr.line2.size() <= 200
          && addr.city is string
          && addr.city.size() > 0
          && addr.city.size() <= 80
          && addr.phone is string
          && addr.phone.size() >= 8
          && addr.phone.size() <= 20
          && (!('couponCode' in o)
            || (o.couponCode is string && o.couponCode.size() > 0 && o.couponCode.size() <= 32))
          && ((!('dropoffLatitude' in o) && !('dropoffLongitude' in o))
            || (o.dropoffLatitude is number && o.dropoffLongitude is number))
          && (!('trackingNumber' in o)
            || (o.trackingNumber is string
              && o.trackingNumber.matches('^MND[0-9]{2}[0-9]{5,12}$')));
      }

      function validOrderCreate() {
        let o = request.resource.data;
        let addr = o.deliveryAddress;
        return o.customerId is string
          && o.customerId == request.auth.uid
          && o.vendorId is string
          && o.vendorId.size() > 0
          && o.vendorId.size() <= 128
          && (!('vendorStoreId' in o)
            || (o.vendorStoreId is string
              && o.vendorStoreId.size() > 0
              && o.vendorStoreId.size() <= 128
              && o.vendorStoreId == o.vendorId))
          && o.storeName is string
          && o.storeName.size() > 0
          && o.storeName.size() <= 120
          && o.status == 'placed'
          && o.paymentMethod == 'cashOnDelivery'
          && o.items is list
          && o.items.size() > 0
          && o.items.size() <= 50
          && o.subtotal is int
          && o.subtotal >= 0
          && o.discount is int
          && o.discount >= 0
          && o.deliveryFee is int
          && o.deliveryFee >= 0
          && (!('serviceCharge' in o)
            || (o.serviceCharge is int && o.serviceCharge >= 0))
          && o.total is int
          && o.total >= 0
          && o.deliveryNote is string
          && o.deliveryNote.size() <= 500
          && o.specialInstructions is string
          && o.specialInstructions.size() <= 500
          && addr is map
          && addr.line1 is string
          && addr.line1.size() > 0
          && addr.line1.size() <= 200
          && addr.line2 is string
          && addr.line2.size() <= 200
          && addr.city is string
          && addr.city.size() > 0
          && addr.city.size() <= 80
          && addr.phone is string
          && addr.phone.size() >= 8
          && addr.phone.size() <= 20
          && (!('couponCode' in o)
            || (o.couponCode is string && o.couponCode.size() > 0 && o.couponCode.size() <= 32))
          && ((!('dropoffLatitude' in o) && !('dropoffLongitude' in o))
            || (o.dropoffLatitude is number && o.dropoffLongitude is number))
          && 'trackingNumber' in o
          && o.trackingNumber is string
          && o.trackingNumber.matches('^MND[0-9]{2}[0-9]{5,12}$');
      }

      /// Vendor board actions (accept / progress / reject). Money and item fields
      /// stay frozen — payouts and vendor stats aggregate from them.
      /// Cancel is only allowed on a still-new order (not yet accepted) —
      /// once it's in the kitchen or ready, the shop has committed to it.
      function vendorOrderStatusTransitionOk() {
        let from = resource.data.status;
        let to = request.resource.data.status;
        let fulfillment = resource.data.get('fulfillmentMode', 'delivery');
        return from == to
          || (from == 'placed' && to in ['confirmed', 'cancelled'])
          || (from in ['confirmed', 'preparing']
            && to in ['confirmed', 'preparing', 'ready'])
          || (from == 'ready'
            && to == 'completed'
            && fulfillment == 'selfPickup');
      }

      function vendorOpenForRidersOk() {
        let o = request.resource.data;
        let fulfillment = resource.data.get('fulfillmentMode', 'delivery');
        return o.status == 'ready' && fulfillment != 'selfPickup'
          ? o.openForRiders == true
          : o.get('openForRiders', false) == false;
      }

      function validVendorOrderUpdate() {
        let o = request.resource.data;
        let c = o.diff(resource.data).affectedKeys();
        return vendorMayAccessThisOrder()
          && orderCoreFieldsUnchanged()
          && vendorOrderStatusTransitionOk()
          && vendorOpenForRidersOk()
          && (o.status == resource.data.status
            || o.status in ['confirmed', 'preparing', 'ready', 'completed', 'cancelled'])
          && c.hasOnly([
            'status', 'vendorStatusUpdatedAt', 'openForRiders',
            'cancelledBy', 'cancellationReason', 'cancelledAt', 'updatedAt'
          ]);
      }

      /// Customers may cancel early unassigned orders, or mark rated — nothing else.
      function validCustomerOrderUpdate() {
        let o = request.resource.data;
        let c = o.diff(resource.data).affectedKeys();
        return isSignedIn()
          && resource.data.customerId == request.auth.uid
          && orderCoreFieldsUnchanged()
          && (
            (o.status == 'cancelled'
              && resource.data.status in ['placed', 'confirmed']
              && orderUnassignedForRiders()
              && c.hasOnly([
                'status', 'cancellationReason', 'cancellationReasonDetail',
                'cancelledAt', 'cancelledBy', 'updatedAt'
              ]))
            || c.hasOnly(['storeRated', 'storeRatingStars', 'updatedAt'])
            || c.hasOnly(['riderRated', 'riderRatingStars', 'updatedAt'])
          );
      }

      // Single-doc get may use get()/exists() helpers (vendor storefront, approval).
      allow get: if isAdmin()
        || vendorMayAccessThisOrder()
        || isAssignedRiderForOrder()
        || (riderIsApproved() && orderOpenForRiderClaim())
        || (isSignedIn() && resource.data.customerId == request.auth.uid);

      // List queries must be provable from equality filters (rules are not filters).
      // Pending riders may list only their own assigned/history rows.
      allow list: if isAdmin()
        || (isSignedIn() && resource.data.assignedRiderId == request.auth.uid)
        || (isSignedIn() && resource.data.riderId == request.auth.uid)
        || (isSignedIn() && resource.data.customerId == request.auth.uid)
        || (isSignedIn() && resource.data.vendorId == request.auth.uid)
        || (isSignedIn() && resource.data.vendorStoreId == request.auth.uid)
        || (isSignedIn()
            && vendorStoreId().size() > 0
            && resource.data.vendorId == vendorStoreId())
        || (riderIsApproved()
            && resource.data.openForRiders == true
            && resource.data.status == 'ready');

      // Customer creates go through placeCashOnDeliveryOrder (Admin SDK).
      allow create: if isAdmin() && validAdminOrderCreate();

      allow update: if isAdmin()
        || validVendorOrderUpdate()
        || validRiderClaimOrder()
        || validRiderAssignedOrderProgress()
        || validCustomerOrderUpdate();

      allow delete: if isAdmin();
    }

    // Global counters — Admin SDK / Cloud Functions only (placeCashOnDeliveryOrder).
    match /system/{docId} {
      allow read: if isSignedIn();
      allow create, update, delete: if false;
    }

    // Notifications: owner reads own notifications; can mark read.
    // Riders may create customer/vendor alerts when accepting a delivery.
    match /notifications/{notificationId} {
      function validRiderNotificationCreate() {
        let n = request.resource.data;
        return isRider()
          && n.userId is string
          && n.userId.size() > 0
          && n.userId.size() <= 128
          && n.orderId is string
          && n.orderId.size() > 0
          && n.orderId.size() <= 128
          && n.type is string
          && n.type == 'rider_accepted'
          && n.title is string
          && n.title.size() > 0
          && n.title.size() <= 120
          && n.body is string
          && n.body.size() > 0
          && n.body.size() <= 500
          && n.createdAt is timestamp
          && (!('read' in n) || n.read is bool);
      }

      function validOwnerNotificationReadUpdate() {
        let c = request.resource.data.diff(resource.data).affectedKeys();
        return isSignedIn()
          && resource.data.userId == request.auth.uid
          && request.resource.data.userId == resource.data.userId
          && (
            c.hasOnly(['read'])
            || c.hasOnly(['read', 'readAt'])
          );
      }

      allow read: if isSignedIn()
        && resource.data.userId == request.auth.uid;
      allow create: if isAdmin() || validRiderNotificationCreate();
      allow update: if isAdmin() || validOwnerNotificationReadUpdate();
      allow delete: if isAdmin();
    }

    // -------------------------------------------------------------------------
    // Jobs module (local employment listings — MND customer app)
    // -------------------------------------------------------------------------
    match /jobs/{jobId} {
      function canReadJob() {
        return resource.data.status == 'active'
          || isAdmin()
          || (isSignedIn() && resource.data.userId == request.auth.uid);
      }

      // Public browse of approved listings; owners see their pending/rejected posts.
      allow read: if canReadJob();

      function validAdminJobCreate() {
        let d = request.resource.data;
        return isAdmin()
          && d.userId is string
          && d.userId.size() > 0
          && d.status in ['active', 'pending']
          && d.title is string
          && d.title.size() >= 3
          && d.title.size() <= 120
          && d.category is string
          && d.category.size() > 0
          && d.type is string
          && d.type.size() > 0
          && d.salary is string
          && d.location is string
          && d.description is string
          && d.description.size() >= 10
          && d.companyName is string
          && d.companyName.size() > 0
          && d.contactPhone is string
          && d.contactPhone.size() >= 8
          && d.createdAt is timestamp
          && d.expiresAt is timestamp
          && (!('availableLaborCount' in d)
            || (d.availableLaborCount is int
              && d.availableLaborCount >= 1
              && d.availableLaborCount <= 99));
      }

      // Non-admin creates go through the createJobPost Cloud Function
      // (Admin SDK, bypasses rules) so the credit spend is atomic with the
      // job write — a direct client create previously could skip
      // decrementing jobPostCredits entirely while still passing a
      // "credits > 0" check, allowing unlimited free posts off one credit.
      // Admin-authored jobs (mnd_web) still create directly.
      allow create: if isAdmin() && validAdminJobCreate();

      function ownerPendingJobPatchOk() {
        let c = request.resource.data.diff(resource.data).affectedKeys();
        return isSignedIn()
          && resource.data.userId == request.auth.uid
          && resource.data.status == 'pending'
          && request.resource.data.userId == resource.data.userId
          && request.resource.data.status == 'pending'
          && (
            c.hasOnly(['imageUrl', 'logoUrl'])
            || c.hasOnly(['imageUrl'])
            || c.hasOnly(['logoUrl'])
          );
      }

      allow update: if isAdmin()
        || ownerPendingJobPatchOk();

      allow delete: if isAdmin()
        || (isSignedIn() && resource.data.userId == request.auth.uid);
    }

    match /job_applications/{applicationId} {
      function jobDocForApplication(jobId) {
        return get(/databases/$(database)/documents/jobs/$(jobId));
      }

      function isJobOwnerForApplication(jobId) {
        return isSignedIn()
          && jobId is string
          && jobId.size() > 0
          && jobId.size() <= 128
          && exists(/databases/$(database)/documents/jobs/$(jobId))
          && jobDocForApplication(jobId).data.userId == request.auth.uid;
      }

      function validJobApplicationCreate() {
        let d = request.resource.data;
        return isSignedIn()
          && d.applicantId == request.auth.uid
          && d.jobId is string
          && d.jobId.size() > 0
          && d.applicantName is string
          && d.applicantPhone is string
          && d.applicantPhone.size() >= 8
          && d.status == 'submitted'
          && d.appliedAt is timestamp
          && isJobOwnerForApplication(d.jobId) == false
          && exists(/databases/$(database)/documents/jobs/$(d.jobId))
          && jobDocForApplication(d.jobId).data.status == 'active';
      }

      function validEmployerApplicationUpdate() {
        let c = request.resource.data.diff(resource.data).affectedKeys();
        return isJobOwnerForApplication(resource.data.jobId)
          && request.resource.data.applicantId == resource.data.applicantId
          && request.resource.data.jobId == resource.data.jobId
          && request.resource.data.status in ['submitted', 'shortlisted', 'booked', 'rejected']
          && (
            c.hasOnly(['status', 'updatedAt'])
            || c.hasOnly(['status', 'updatedAt', 'bookedAt'])
          );
      }

      allow read: if isAdmin()
        || (isSignedIn() && resource.data.applicantId == request.auth.uid)
        || isJobOwnerForApplication(resource.data.jobId);

      allow create: if validJobApplicationCreate();
      allow update: if isAdmin() || validEmployerApplicationUpdate();
      allow delete: if isAdmin();
    }

    match /saved_jobs/{docId} {
      allow read: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow create: if isSignedIn()
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.jobId is string
        && request.resource.data.savedAt is timestamp;
      allow delete: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow update: if false;
    }

    match /job_reports/{reportId} {
      allow read: if isAdmin();
      allow create: if isSignedIn()
        && request.resource.data.reporterId == request.auth.uid
        && request.resource.data.jobId is string
        && request.resource.data.reason is string
        && request.resource.data.createdAt is timestamp;
      allow update, delete: if isAdmin();
    }

    // Customer → shop ratings (one doc per delivered order; doc id == orderId).
    match /store_ratings/{orderId} {
      function storeRatingOrder() {
        return get(/databases/$(database)/documents/orders/$(orderId)).data;
      }

      function storeRatingOrderExists() {
        return exists(/databases/$(database)/documents/orders/$(orderId));
      }

      function validStoreRatingCreate() {
        let d = request.resource.data;
        let o = storeRatingOrder();
        return isSignedIn()
          && storeRatingOrderExists()
          && d.orderId == orderId
          && d.customerId == request.auth.uid
          && o.customerId == request.auth.uid
          && o.status in ['delivered', 'completed']
          && (!('storeRated' in o) || o.storeRated != true)
          && d.vendorId is string
          && d.vendorId.size() > 0
          && d.vendorId.size() <= 128
          && d.vendorId == o.vendorId
          && d.storeName is string
          && d.storeName.size() > 0
          && d.storeName.size() <= 120
          && d.stars is int
          && d.stars >= 1
          && d.stars <= 5
          && d.comment is string
          && d.comment.size() <= 500
          && d.status == 'visible'
          && d.createdAt is timestamp
          && d.updatedAt is timestamp;
      }

      // `resource == null` covers the pre-create existence check the client
      // transaction runs before writing a new rating (submitStoreRating) —
      // without it, reading a not-yet-created doc errors on resource.data
      // and Firestore surfaces that as permission-denied.
      allow read: if isAdmin()
        || (isSignedIn() && resource == null)
        || (isSignedIn() && resource.data.customerId == request.auth.uid)
        || (isSignedIn() && resource.data.status == 'visible');

      allow create: if validStoreRatingCreate();

      allow update: if isAdmin()
        && request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['status', 'updatedAt'])
        && request.resource.data.status in ['visible', 'hidden']
        && request.resource.data.updatedAt is timestamp;

      allow delete: if isAdmin();
    }

    // Customer → rider ratings (one doc per completed order or ride trip;
    // doc id == orderId or tripId, whichever collection actually has it).
    match /rider_ratings/{orderId} {
      function riderRatingOrderRiderId(o) {
        return 'riderId' in o && o.riderId is string && o.riderId.size() > 0
          ? o.riderId
          : (o.assignedRiderId is string ? o.assignedRiderId : '');
      }

      function validRiderRatingCreate() {
        let d = request.resource.data;
        // A rating doc's id is either a delivery order id or a ride trip
        // id — check both collections rather than assuming one.
        let orderExists = exists(/databases/$(database)/documents/orders/$(orderId));
        let tripExists = exists(/databases/$(database)/documents/trips/$(orderId));
        let o = orderExists
          ? get(/databases/$(database)/documents/orders/$(orderId)).data
          : get(/databases/$(database)/documents/trips/$(orderId)).data;
        return isSignedIn()
          && (orderExists || tripExists)
          && d.orderId == orderId
          && d.customerId == request.auth.uid
          && o.customerId == request.auth.uid
          && o.status in ['delivered', 'completed']
          && (!('riderRated' in o) || o.riderRated != true)
          && d.riderId is string
          && d.riderId.size() > 0
          && d.riderId.size() <= 128
          && d.riderId == riderRatingOrderRiderId(o)
          && d.stars is int
          && d.stars >= 1
          && d.stars <= 5
          && d.comment is string
          && d.comment.size() <= 500
          && d.status == 'visible'
          && d.createdAt is timestamp
          && d.updatedAt is timestamp;
      }

      // `resource == null` covers the pre-create existence check the client
      // transaction runs before writing a new rating (submitRiderRating) —
      // without it, reading a not-yet-created doc errors on resource.data
      // and Firestore surfaces that as permission-denied.
      allow read: if isAdmin()
        || (isSignedIn() && resource == null)
        || (isSignedIn() && resource.data.customerId == request.auth.uid)
        || (isSignedIn() && resource.data.status == 'visible');

      allow create: if validRiderRatingCreate();

      allow update: if isAdmin()
        && request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['status', 'updatedAt'])
        && request.resource.data.status in ['visible', 'hidden']
        && request.resource.data.updatedAt is timestamp;

      allow delete: if isAdmin();
    }

    // Short-lived ride fare quotes (written only by Admin SDK / Cloud Functions).
    match /ride_fare_quotes/{quoteId} {
      allow read: if isSignedIn()
        && resource.data.customerId == request.auth.uid;
      allow create, update, delete: if false;
    }

    // Admin-managed ride fare rates (Bike / Wheel / Car).
    match /ride_fare_config/{docId} {
      function validFareVehicleRates(m) {
        return m is map
          && m.baseLkr is int
          && m.baseLkr >= 0
          && m.baseLkr <= 100000
          && m.perKmLkr is int
          && m.perKmLkr >= 0
          && m.perKmLkr <= 100000
          && m.minLkr is int
          && m.minLkr >= 0
          && m.minLkr <= 100000
          && (!('perStopLkr' in m)
            || (m.perStopLkr is int && m.perStopLkr >= 0 && m.perStopLkr <= 100000));
      }

      function validRideFareConfigDoc() {
        let d = request.resource.data;
        return validFareVehicleRates(d.bike)
          && validFareVehicleRates(d.wheel)
          && validFareVehicleRates(d.car);
      }

      allow read: if isSignedIn();
      allow create, update: if isAdmin() && validRideFareConfigDoc();
      allow delete: if isAdmin();
    }

    // Passenger ride trips.
    match /trips/{tripId} {
      function isAssignedRiderForTrip() {
        return isSignedIn()
          && (
            (resource.data.assignedRiderId is string
              && resource.data.assignedRiderId == request.auth.uid)
            || (resource.data.riderId is string
              && resource.data.riderId == request.auth.uid)
          );
      }

      function tripUnassignedForRiders() {
        return !('assignedRiderId' in resource.data)
          || resource.data.assignedRiderId == null
          || (resource.data.assignedRiderId is string
            && resource.data.assignedRiderId.size() == 0);
      }

      function tripOpenForRiderClaim() {
        return resource.data.status == 'searching'
          && resource.data.openForRiders == true
          && tripUnassignedForRiders();
      }

      function tripCoreFieldsUnchanged() {
        let o = request.resource.data;
        let r = resource.data;
        return o.customerId == r.customerId
          && o.vehicleType == r.vehicleType
          && o.estimatedFareLkr == r.estimatedFareLkr
          && o.distanceKm == r.distanceKm
          && o.paymentMethod == r.paymentMethod
          && o.pickup == r.pickup
          && o.dropoff == r.dropoff
          && (('stops' in o) == ('stops' in r))
          && (!('stops' in r) || o.stops == r.stops)
          // Explicit equality checks (in addition to the c.hasOnly([...])
          // whitelist on each caller) so payment state can never be
          // smuggled into a rider/customer trip update — mirrors
          // orderCoreFieldsUnchanged()'s redundant productCash* checks.
          && o.get('paymentStatus', r.get('paymentStatus', ''))
            == r.get('paymentStatus', '')
          && o.get('paymentProvider', r.get('paymentProvider', ''))
            == r.get('paymentProvider', '')
          && o.get('paymentTransactionId', r.get('paymentTransactionId', ''))
            == r.get('paymentTransactionId', '')
          && o.get('fareQuoteId', r.get('fareQuoteId', ''))
            == r.get('fareQuoteId', '');
      }

      function validTripPlaceMap(m) {
        return m is map
          && m.lat is number
          && m.lng is number
          && m.label is string
          && m.label.size() > 0
          && m.label.size() <= 240;
      }

      // Currently unused: `allow create: if false` below means every trip is
      // created by a Cloud Function via the Admin SDK, which bypasses rules
      // entirely. Kept as a rules-level backstop in case a future path ever
      // creates trips directly from a client — deleting it would remove that
      // backstop with no benefit, since it costs nothing while inert.
      function validTripCreate() {
        let o = request.resource.data;
        return o.customerId == request.auth.uid
          && o.contactPhone is string
          && o.contactPhone.size() >= 8
          && o.contactPhone.size() <= 20
          && (!('driverNote' in o)
            || (o.driverNote is string && o.driverNote.size() <= 500))
          && validTripPlaceMap(o.pickup)
          && validTripPlaceMap(o.dropoff)
          && o.vehicleType in ['wheel', 'bike', 'car']
          && o.distanceKm is number
          && o.distanceKm >= 0
          && o.estimatedFareLkr is int
          && o.estimatedFareLkr >= 0
          && o.fareQuoteId is string
          && o.fareQuoteId.size() > 0
          && o.fareQuoteId.size() <= 128
          && o.status in ['draft_payment', 'searching']
          && o.paymentMethod in ['cash', 'payhere']
          && o.paymentStatus in ['pending', 'paid']
          && o.openForRiders is bool
          && (o.paymentMethod == 'cash'
            ? (o.status == 'searching'
              && o.paymentStatus == 'pending'
              && o.openForRiders == true)
            : (o.status == 'draft_payment'
              && o.paymentStatus == 'pending'
              && o.openForRiders == false));
      }

      function validCustomerCancelSearchingTrip() {
        let o = request.resource.data;
        let c = o.diff(resource.data).affectedKeys();
        return isSignedIn()
          && resource.data.customerId == request.auth.uid
          // 'draft_payment' included so a trip stuck before payment is
          // confirmed (e.g. abandoned PayHere checkout) is not permanently
          // uncancellable. 'accepted' included so a passenger isn't stuck
          // waiting on a rider who accepted and then went silent/no-showed —
          // once the rider has actually arrived ('arrived'/'in_progress'),
          // only the rider (or admin) can cancel.
          && resource.data.status in ['searching', 'draft_payment', 'accepted']
          && o.status == 'cancelled'
          && o.openForRiders == false
          && c.hasOnly([
            'status', 'openForRiders', 'cancelledAt', 'cancelReason', 'updatedAt'
          ]);
      }

      /// Customer may rate the rider once, only after the trip is completed
      /// — mirrors validCustomerOrderUpdate's riderRated/riderRatingStars path.
      function validCustomerRateTrip() {
        let o = request.resource.data;
        let c = o.diff(resource.data).affectedKeys();
        return isSignedIn()
          && resource.data.customerId == request.auth.uid
          && resource.data.status == 'completed'
          && (!('riderRated' in resource.data) || resource.data.riderRated != true)
          && tripCoreFieldsUnchanged()
          && c.hasOnly(['riderRated', 'riderRatingStars', 'updatedAt']);
      }

      function validRiderClaimTrip() {
        let o = request.resource.data;
        let c = o.diff(resource.data).affectedKeys();
        return isRider()
          && riderIsApproved()
          // See validRiderClaimOrder — same cash-in-hand gate, and likewise
          // only on the claim, never on an in-flight trip's progress.
          && !riderCashHoldActive()
          && tripOpenForRiderClaim()
          && tripCoreFieldsUnchanged()
          && riderVehicleMatchesTripVehicle(resource.data.vehicleType)
          && o.assignedRiderId == request.auth.uid
          && o.riderId == request.auth.uid
          && o.openForRiders == false
          && o.status == 'accepted'
          && o.riderAcceptedAt is timestamp
          && c.hasOnly([
            'assignedRiderId', 'riderId', 'openForRiders', 'status',
            'riderAcceptedAt', 'updatedAt'
          ]);
      }

      // 'completed' is reachable only from 'in_progress' — a rider must
      // actually start the trip before finishing it, so a claimed ride
      // can't be marked done without ever picking up or dropping off.
      function tripStatusTransitionOk(fromStatus, toStatus) {
        return (fromStatus == 'accepted'
            && toStatus in ['arrived', 'in_progress', 'cancelled'])
          || (fromStatus == 'arrived'
            && toStatus in ['in_progress', 'cancelled'])
          || (fromStatus == 'in_progress'
            && toStatus in ['completed', 'cancelled']);
      }

      // Every stop must be visited (currentStopIndex caught up to
      // stops.size(), advanced only via validRiderStopAdvance) before a
      // trip with intermediate stops can be marked completed.
      function tripStopsFullyVisited() {
        let r = resource.data;
        return !('stops' in r)
          || r.stops.size() == 0
          || r.get('currentStopIndex', 0) >= r.stops.size();
      }

      // Advancing past an intermediate stop, mid-leg — status stays
      // 'in_progress' so tripStatusTransitionOk() doesn't apply here.
      function validRiderStopAdvance() {
        let o = request.resource.data;
        let r = resource.data;
        let c = o.diff(r).affectedKeys();
        return isRider()
          && riderIsApproved()
          && isAssignedRiderForTrip()
          && tripCoreFieldsUnchanged()
          && r.status == 'in_progress'
          && o.status == 'in_progress'
          && ('stops' in r) && r.stops.size() > 0
          && o.currentStopIndex == (('currentStopIndex' in r) ? r.currentStopIndex : 0) + 1
          && o.currentStopIndex <= r.stops.size()
          && c.hasOnly(['currentStopIndex', 'updatedAt']);
      }

      function validRiderTripProgress() {
        let o = request.resource.data;
        let r = resource.data;
        let c = o.diff(r).affectedKeys();
        return isRider()
          && riderIsApproved()
          && isAssignedRiderForTrip()
          && tripCoreFieldsUnchanged()
          && o.riderId == r.riderId
          && o.assignedRiderId == r.assignedRiderId
          && o.openForRiders == false
          && o.status in ['arrived', 'in_progress', 'completed', 'cancelled']
          && tripStatusTransitionOk(r.status, o.status)
          && (o.status != 'completed' || tripStopsFullyVisited())
          && c.hasOnly([
            'status', 'updatedAt', 'arrivedAt', 'startedAt', 'completedAt',
            'cancelledAt', 'cancelReason'
          ]);
      }

      allow get: if isAdmin()
        || isAssignedRiderForTrip()
        || (riderIsApproved() && tripOpenForRiderClaim())
        || (isSignedIn() && resource.data.customerId == request.auth.uid);

      allow list: if isAdmin()
        || (isSignedIn() && resource.data.assignedRiderId == request.auth.uid)
        || (isSignedIn() && resource.data.riderId == request.auth.uid)
        || (isSignedIn() && resource.data.customerId == request.auth.uid)
        || (riderIsApproved()
            && resource.data.openForRiders == true
            && resource.data.status == 'searching');

      // Creates must go through Cloud Functions (Admin SDK) — no client trip create.
      allow create: if false;

      allow update: if isAdmin()
        || validRiderClaimTrip()
        || validRiderTripProgress()
        || validRiderStopAdvance()
        || validCustomerCancelSearchingTrip()
        || validCustomerRateTrip();

      allow delete: if isAdmin();
    }

    // Ops alerts for missed shop orders (written by Cloud Functions).
    match /admin_alerts/{alertId} {
      allow read: if isAdmin();
      allow update: if isAdmin();
      allow create: if false;
      allow delete: if isAdmin();
    }

    // Collection-group query used by AdminWithdrawalsPage. Nested
    // riders/{id}/withdrawals rules do not cover collectionGroup('withdrawals').
    match /{path=**}/withdrawals/{withdrawalId} {
      allow read: if isAdmin();
    }

    // Collection-group query behind the admin panel's pending-handover queue.
    // Same reason as withdrawals: the nested riders/{id}/cash_settlements rule
    // does not cover collectionGroup('cash_settlements').
    match /{path=**}/cash_settlements/{settlementId} {
      allow read: if isAdmin();
    }

    // Device tokens: owner manages own token docs (FCM registry).
    match /device_tokens/{tokenId} {
      function validDeviceTokenWrite() {
        let d = request.resource.data;
        return d.userId == request.auth.uid
          && d.token is string
          && d.token.size() >= 20
          && d.token.size() <= 4096
          && d.platform is string
          && d.platform.size() > 0
          && d.platform.size() <= 32
          && d.app is string
          && d.app in ['mnd_rider', 'mnd_customer', 'mnd_shop', 'mnd_web']
          && (!('role' in d) || d.role is string);
      }

      allow read: if isSignedIn()
        && resource.data.userId == request.auth.uid;
      allow create, update: if isSignedIn() && validDeviceTokenWrite();
      allow delete: if isSignedIn()
        && resource.data.userId == request.auth.uid;
    }
  }
}
