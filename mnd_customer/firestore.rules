rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }

    function isSelf(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    function userDoc() {
      return get(/databases/$(database)/documents/customers/$(request.auth.uid));
    }

    function userDocExists() {
      return exists(/databases/$(database)/documents/customers/$(request.auth.uid));
    }

    function vendorSelfDoc() {
      return get(/databases/$(database)/documents/vendors/$(request.auth.uid));
    }

    function vendorSelfDocExists() {
      return exists(/databases/$(database)/documents/vendors/$(request.auth.uid));
    }

    function riderSelfDocExists() {
      return isSignedIn()
        && exists(/databases/$(database)/documents/riders/$(request.auth.uid));
    }

    function riderSelfDoc() {
      return get(/databases/$(database)/documents/riders/$(request.auth.uid));
    }

    function riderIsApproved() {
      return riderSelfDocExists()
        && riderSelfDoc().data.status is string
        && (riderSelfDoc().data.status == 'approved'
          || riderSelfDoc().data.status == 'active');
    }

    function riderStatusUnchanged() {
      return request.resource.data.status == resource.data.get('status', 'pending');
    }

    function userRole() {
      return !isSignedIn()
        ? null
        : (userDocExists() && 'role' in userDoc().data && userDoc().data.role is string
            ? userDoc().data.role
            : (vendorSelfDocExists()
                && 'role' in vendorSelfDoc().data
                && vendorSelfDoc().data.role is string
                ? vendorSelfDoc().data.role
                : null));
    }

    /// Matches Console / imports where role casing varies (Admin, ADMIN).
    function isAdmin() {
      let r = userRole();
      return r == 'admin' || r == 'Admin' || r == 'ADMIN';
    }

    function isRider() {
      return riderSelfDocExists();
    }

    function isVendor() {
      let r = userRole();
      return r == 'vendor' || r == 'Vendor' || r == 'VENDOR';
    }

    // Vendors scoped to their Firestore store id (must match orders.vendorId and vendors/{id}).
    function vendorStoreId() {
      return (userDocExists()
          && 'vendorStoreId' in userDoc().data
          && userDoc().data.vendorStoreId is string)
        ? userDoc().data.vendorStoreId
        : ((vendorSelfDocExists()
              && 'vendorStoreId' in vendorSelfDoc().data
              && vendorSelfDoc().data.vendorStoreId is string)
            ? vendorSelfDoc().data.vendorStoreId
            : '');
    }

    /// Canonical store id on an order: [vendorId] (primary) or [vendorStoreId] (alias — same value as vendors doc id / profile vendorStoreId).
    function orderVendorStoreKey() {
      let o = resource.data;
      return ('vendorId' in o && o.vendorId is string && o.vendorId.size() > 0)
        ? o.vendorId
        : (
            ('vendorStoreId' in o && o.vendorStoreId is string && o.vendorStoreId.size() > 0)
              ? o.vendorStoreId
              : ''
          );
    }

    /// [orderVendorStoreKey] maps to vendors/{id}; allow if that storefront belongs to this auth user.
    function vendorOrderStorefrontOwnedByAuth() {
      let vid = orderVendorStoreKey();
      let vpath = /databases/$(database)/documents/vendors/$(vid);
      return isSignedIn()
        && vid is string
        && vid.size() > 0
        && vid.size() <= 128
        && exists(vpath)
        && (
          vid == request.auth.uid
          || (
            'uid' in get(vpath).data
            && get(vpath).data.uid is string
            && get(vpath).data.uid == request.auth.uid
          )
        );
    }

    function vendorMayAccessThisOrder() {
      return orderVendorStoreKey().size() > 0
        && orderVendorStoreKey().size() <= 128
        && (
          vendorOrderStorefrontOwnedByAuth()
          ||
          // Profile vendorStoreId on customers/ or vendors/{auth} must match order store key.
          ((isVendor() || exists(/databases/$(database)/documents/vendors/$(request.auth.uid)))
            && vendorStoreId().size() > 0
            && orderVendorStoreKey() == vendorStoreId())
        );
    }

    // User profile: owner can read/update own profile (customers, riders, admins; legacy vendors).
    // Shop app self-register uses [vendors] only — see validSelfServeVendorCreate.
    match /customers/{uid} {
      allow read: if isSelf(uid) || isAdmin();

      function validVendorUserCreate() {
        let d = request.resource.data;
        return d.uid == request.auth.uid
          && d.role == 'vendor'
          && d.vendorStoreId is string
          && d.vendorStoreId == request.auth.uid
          && d.vendorStoreId.size() > 0
          && d.vendorStoreId.size() <= 128
          && d.displayName is string
          && d.displayName.size() > 0
          && d.displayName.size() <= 120
          && (!('email' in d) || (d.email is string && d.email.size() <= 200))
          && (!('phoneNumber' in d) || (d.phoneNumber is string && d.phoneNumber.size() <= 32));
      }

      allow create: if isSelf(uid)
        && request.resource.data.uid == request.auth.uid
        && (request.resource.data.role == 'customer'
          || (request.resource.data.role == 'vendor' && validVendorUserCreate()));

      allow update: if isSelf(uid)
        && request.resource.data.uid == resource.data.uid
        && request.resource.data.role == resource.data.role;

      allow delete: if isAdmin();

      match /saved_addresses/{addressId} {
        function validSavedAddress() {
          let data = request.resource.data;
          return data.label is string
            && data.label.size() > 0
            && data.label.size() <= 48
            && data.line1 is string
            && data.line1.size() > 0
            && data.line1.size() <= 200
            && data.line2 is string
            && data.line2.size() <= 200
            && data.city is string
            && data.city.size() > 0
            && data.city.size() <= 80
            && data.phone is string
            && data.phone.size() >= 8
            && data.phone.size() <= 20
            && data.isDefault is bool;
        }

        allow read: if isSelf(uid);

        allow create: if isSelf(uid) && validSavedAddress();

        allow update: if isSelf(uid) && validSavedAddress();

        allow delete: if isSelf(uid);
      }
    }

    // Catalog read is public so the customer app can show real Firestore data while browsing
    // (including guest mode). Writes remain restricted.
    match /vendors/{vendorId} {
      allow read: if true;

      function validSelfServeVendorCreate() {
        let d = request.resource.data;
        return d.uid == request.auth.uid
          && d.role == 'vendor'
          && d.vendorStoreId is string
          && d.vendorStoreId == request.auth.uid
          && d.vendorStoreId.size() > 0
          && d.vendorStoreId.size() <= 128
          && d.name is string
          && d.name.size() > 0
          && d.name.size() <= 120
          && (!('description' in d) || (d.description is string && d.description.size() <= 200))
          && d.active is bool
          && d.active == false
          && 'approvalStatus' in d
          && d.approvalStatus is string
          && d.approvalStatus == 'pending'
          && (!('email' in d) || (d.email is string && d.email.size() <= 200));
      }

      /// Non-admin vendors cannot publish (`active: true`) or change approval until `approvalStatus` is `approved`.
      /// (Firestore rules functions cannot use `if` — use ternary / boolean logic only.)
      function vendorOwnVendorDocUpdateOk() {
        let b = resource.data;
        let a = request.resource.data;
        let approvalOk = (!('approvalStatus' in b) || !(b.approvalStatus is string))
          ? true
          : (
              b.approvalStatus == 'approved'
                ? (!('approvalStatus' in a) || a.approvalStatus == 'approved')
                : (a.active == false && (!('approvalStatus' in a) || a.approvalStatus == b.approvalStatus))
            );
        // rating / ratingCount are owned by Cloud Functions (store_ratings aggregation).
        let ratingFieldsUnchanged = !a.diff(b).affectedKeys()
          .hasAny(['rating', 'ratingCount']);
        return approvalOk && ratingFieldsUnchanged;
      }

      function vendorNonAdminStoreOwner(vendorId) {
        return isSignedIn() && (
          vendorId == request.auth.uid
          || (isVendor() && vendorStoreId().size() > 0 && vendorId == vendorStoreId())
        );
      }

      // New shop: single vendors/{authUid} doc (shop app registration; no customers/{uid} row required).
      allow create: if isAdmin() || isVendor()
        || (isSignedIn() && vendorId == request.auth.uid && validSelfServeVendorCreate());
      // Own doc id (self-register) OR profile-linked store id (legacy slug doc).
      allow update: if isAdmin()
        || (vendorNonAdminStoreOwner(vendorId) && vendorOwnVendorDocUpdateOk());
      allow delete: if isAdmin()
        || vendorNonAdminStoreOwner(vendorId);

      match /notifications/{notificationId} {
        function validRiderVendorNotificationCreate() {
          let n = request.resource.data;
          return isRider()
            && n.orderId is string
            && n.orderId.size() > 0
            && n.type is string
            && n.type == 'rider_accepted'
            && n.title is string
            && n.title.size() > 0
            && n.title.size() <= 120
            && n.body is string
            && n.body.size() > 0
            && n.body.size() <= 500
            && n.createdAt is timestamp
            && (!('read' in n) || n.read is bool);
        }

        allow read: if isSignedIn()
          && (vendorNonAdminStoreOwner(vendorId) || isAdmin());
        allow create: if isAdmin() || validRiderVendorNotificationCreate();
        allow update: if isSignedIn()
          && vendorNonAdminStoreOwner(vendorId)
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['read', 'readAt']);
        allow delete: if isAdmin();
      }
    }

    // Products: public read for storefront; writes restricted.
    // Writes: admin, or the store owner (storeId == auth uid). Shop app ties storeId to uid;
    // do not rely only on customers/{uid}.role == 'vendor' (missing/out-of-sync profile caused
    // permission-denied on product create).
    match /products/{productId} {
      allow read: if true;

      function ownsProductStoreOnWrite() {
        return isSignedIn()
          && request.resource.data.keys().hasAll(['storeId'])
          && request.resource.data.storeId is string
          && request.resource.data.storeId == request.auth.uid;
      }

      function ownsProductStoreOnReadDoc() {
        return isSignedIn()
          && resource.data.keys().hasAll(['storeId'])
          && resource.data.storeId is string
          && resource.data.storeId == request.auth.uid;
      }

      function productStoreIdUnchanged() {
        return request.resource.data.storeId == resource.data.storeId;
      }

      allow create: if isAdmin() || ownsProductStoreOnWrite();

      allow update: if isAdmin()
        || (ownsProductStoreOnReadDoc() && productStoreIdUnchanged());

      allow delete: if isAdmin() || ownsProductStoreOnReadDoc();
    }

    // Home promo banners: public read; admin manages writes.
    match /banners/{bannerId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    // Broad vendor categories (Food, Grocery). Shop app reads without auth.
    match /shop_categories/{categoryId} {
      allow read: if true;

      function validShopCategoryDoc() {
        let d = request.resource.data;
        let orderOk = d.order is int || d.order is float || d.order is number;
        return d.label is string
          && d.label.size() > 0
          && d.label.size() <= 80
          && orderOk
          && d.active is bool;
      }

      allow create: if isAdmin() && validShopCategoryDoc();
      allow update: if isAdmin() && validShopCategoryDoc();
      allow delete: if isAdmin();
    }

    // Specific shop kinds under a shop_categories doc (`categoryId`). Public read.
    match /shop_types/{typeId} {
      allow read: if true;

      function validShopTypeDoc() {
        let d = request.resource.data;
        let orderOk = d.order is int || d.order is float || d.order is number;
        return d.label is string
          && d.label.size() > 0
          && d.label.size() <= 80
          && orderOk
          && d.active is bool
          && d.categoryId is string
          && d.categoryId.size() > 0
          && d.categoryId.size() <= 128;
      }

      allow create: if isAdmin() && validShopTypeDoc();
      allow update: if isAdmin() && validShopTypeDoc();
      allow delete: if isAdmin();
    }

    // -------------------------------------------------------------------------
    // Riders (MND Rider app) — profile, earnings subcollections, inbox
    // -------------------------------------------------------------------------
    match /riders/{riderId} {
      function canReadRiderDoc() {
        return isSelf(riderId) || isAdmin() || isSignedIn();
      }

      function validRiderRegistrationCreate() {
        let d = request.resource.data;
        return d.uid == riderId
          && d.role == 'rider'
          && d.status == 'pending'
          && d.online == false
          && d.registrationComplete == true
          && d.fullName is string
          && d.fullName.size() >= 2
          && d.fullName.size() <= 120
          && d.phone is string
          && d.phone.size() >= 10
          && d.phone.size() <= 20
          && d.nicNumber is string
          && d.nicNumber.size() >= 9
          && d.nicNumber.size() <= 14
          && d.vehicleType is string
          && d.vehicleType in ['bike', 'three_wheeler', 'van']
          && d.vehicleNumber is string
          && d.vehicleNumber.size() >= 3
          && d.vehicleNumber.size() <= 20
          && d.city is string
          && d.city.size() >= 2
          && d.city.size() <= 80;
      }

      function validRiderProfilePatch() {
        let c = request.resource.data.diff(resource.data).affectedKeys();
        return c.hasOnly([
            'fullName', 'phone', 'nicNumber', 'city', 'vehicleType', 'vehicleNumber',
            'profilePhotoUrl', 'licensePhotoUrl', 'email', 'registrationComplete', 'updatedAt'
          ]);
      }

      function validRiderPresencePatch() {
        let c = request.resource.data.diff(resource.data).affectedKeys();
        return c.hasOnly(['online', 'updatedAt'])
          || c.hasOnly(['online', 'locationUpdatedAt', 'updatedAt'])
          || c.hasOnly(['online', 'locationUpdatedAt']);
      }

      function validRiderLocationPatch() {
        let c = request.resource.data.diff(resource.data).affectedKeys();
        return c.hasOnly([
            'currentLocation', 'latitude', 'longitude', 'heading', 'speed',
            'locationUpdatedAt', 'online', 'updatedAt'
          ])
          || c.hasOnly([
            'currentLocation', 'latitude', 'longitude', 'heading', 'speed',
            'locationUpdatedAt', 'online'
          ]);
      }

      function validRiderFcmPatch() {
        let c = request.resource.data.diff(resource.data).affectedKeys();
        return c.hasOnly(['fcmToken', 'fcmTokenUpdatedAt', 'updatedAt']);
      }

      function validRiderSelfUpdate() {
        return request.resource.data.uid == resource.data.get('uid', riderId)
          && request.resource.data.role == resource.data.get('role', 'rider')
          && riderStatusUnchanged()
          && (
            validRiderProfilePatch()
            || validRiderPresencePatch()
            || validRiderLocationPatch()
            || validRiderFcmPatch()
          );
      }

      allow read: if canReadRiderDoc();
      allow create: if isAdmin()
        || (isSelf(riderId) && validRiderRegistrationCreate());
      allow update: if isAdmin() || (isSelf(riderId) && validRiderSelfUpdate());
      allow delete: if isAdmin();

      match /wallet/{docId} {
        function validWalletDoc() {
          let w = request.resource.data;
          return w.balanceLkr is number
            && w.pendingWithdrawalLkr is number
            && w.lifetimeEarnedLkr is number
            && w.lifetimeWithdrawnLkr is number
            && w.balanceLkr >= 0
            && w.pendingWithdrawalLkr >= 0
            && w.lifetimeEarnedLkr >= 0
            && w.lifetimeWithdrawnLkr >= 0;
        }

        allow read: if isSelf(riderId) || isAdmin();
        allow create, update: if isSelf(riderId) && riderIsApproved() && validWalletDoc();
        allow delete: if isAdmin();
      }

      match /earnings_aggregates/{periodKey} {
        function validAggregateDoc() {
          let a = request.resource.data;
          return a.periodType is string
            && a.periodType in ['daily', 'weekly', 'monthly']
            && a.totalLkr is number
            && a.tripCount is number
            && a.totalLkr >= 0
            && a.tripCount >= 0;
        }

        allow read: if isSelf(riderId) || isAdmin();
        allow create, update: if isSelf(riderId) && riderIsApproved() && validAggregateDoc();
        allow delete: if isAdmin();
      }

      match /transactions/{transactionId} {
        function validRiderTransactionCreate() {
          let t = request.resource.data;
          return t.type is string
            && t.status is string
            && t.amountLkr is number
            && t.title is string
            && t.title.size() > 0
            && t.title.size() <= 120
            && t.subtitle is string
            && t.subtitle.size() <= 200
            && t.createdAt is timestamp
            && (
              (t.type == 'delivery_earning'
                && t.status == 'completed'
                && t.amountLkr > 0
                && t.amountLkr <= 500000
                && t.orderId is string
                && t.orderId.size() > 0
                && transactionId == 'earning_' + t.orderId)
              || (t.type == 'withdrawal'
                && t.status == 'pending'
                && t.amountLkr < 0
                && t.amountLkr >= -500000
                && t.withdrawalId is string
                && t.withdrawalId.size() > 0)
            );
        }

        allow read: if isSelf(riderId) || isAdmin();
        allow create: if isSelf(riderId) && riderIsApproved() && validRiderTransactionCreate();
        allow update, delete: if isAdmin();
      }

      match /withdrawals/{withdrawalId} {
        function validRiderWithdrawalCreate() {
          let w = request.resource.data;
          return w.amountLkr is number
            && w.amountLkr >= 500
            && w.amountLkr <= 500000
            && w.status == 'pending'
            && w.payoutMethod is string
            && w.payoutMethod in ['bank', 'mobile']
            && w.payoutAccount is string
            && w.payoutAccount.size() >= 4
            && w.payoutAccount.size() <= 64
            && w.createdAt is timestamp;
        }

        allow read: if isSelf(riderId) || isAdmin();
        allow create: if isSelf(riderId) && riderIsApproved() && validRiderWithdrawalCreate();
        allow update, delete: if isAdmin();
      }

      match /notifications/{notificationId} {
        function validRiderInboxCreate() {
          return false;
        }

        allow read: if isSelf(riderId) || isAdmin();
        allow create: if isAdmin() || validRiderInboxCreate();
        allow update: if isSelf(riderId)
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['read']);
        allow delete: if isAdmin();
      }
    }

    // High-frequency GPS (recommended split from profile doc).
    match /rider_locations/{riderId} {
      function validRiderLocationDoc() {
        let d = request.resource.data;
        return d.riderId == riderId
          && d.latitude is number
          && d.longitude is number
          && d.location is latlng
          && d.online is bool;
      }

      allow read: if isSignedIn();
      allow create, update: if isAdmin()
        || (isSelf(riderId) && riderIsApproved() && validRiderLocationDoc());
      allow delete: if isAdmin();
    }

    // Orders: any signed-in user may create/read/update their own rows when customerId matches
    // auth uid (validOrderCreate already enforces that on create). Role in customers/{uid} is not
    // required — avoids permission-denied when profile/role is missing or vendor shops as buyer.
    // Rider/vendor/admin can read and update orders for operations.
    match /orders/{orderId} {
      function isAssignedRiderForOrder() {
        return isSignedIn()
          && (
            (resource.data.assignedRiderId is string && resource.data.assignedRiderId == request.auth.uid)
            || (resource.data.riderId is string && resource.data.riderId == request.auth.uid)
          );
      }

      function orderUnassignedForRiders() {
        return !('assignedRiderId' in resource.data)
          || resource.data.assignedRiderId == null
          || (resource.data.assignedRiderId is string
            && resource.data.assignedRiderId.size() == 0);
      }

      function orderOpenForRiderClaim() {
        return resource.data.status == 'ready'
          && resource.data.openForRiders == true
          && orderUnassignedForRiders();
      }

      function orderCoreFieldsUnchanged() {
        let o = request.resource.data;
        let r = resource.data;
        return o.customerId == r.customerId
          && o.vendorId == r.vendorId
          && o.get('vendorStoreId', r.get('vendorStoreId', ''))
            == r.get('vendorStoreId', '')
          && o.storeName == r.storeName
          && o.subtotal == r.subtotal
          && o.discount == r.discount
          && o.deliveryFee == r.deliveryFee
          && o.total == r.total
          && o.items == r.items
          && o.paymentMethod == r.paymentMethod;
      }

      function validRiderClaimOrder() {
        let o = request.resource.data;
        let c = o.diff(resource.data).affectedKeys();
        return isRider()
          && riderIsApproved()
          && orderOpenForRiderClaim()
          && orderCoreFieldsUnchanged()
          && o.assignedRiderId == request.auth.uid
          && o.riderId == request.auth.uid
          && o.openForRiders == false
          && o.status == 'out_for_delivery'
          && o.riderAcceptedAt is timestamp
          && c.hasOnly([
            'assignedRiderId', 'riderId', 'openForRiders', 'status',
            'riderAcceptedAt', 'riderStatusUpdatedAt',
            'pickupLatitude', 'pickupLongitude', 'pickupAddress'
          ]);
      }

      function riderDeliveryStatusTransitionOk(fromStatus, toStatus) {
        let from = fromStatus == null ? '' : fromStatus;
        return (from == 'out_for_delivery'
            && toStatus in ['picked_up', 'on_the_way', 'delivered'])
          || (from == 'picked_up' && toStatus in ['on_the_way', 'delivered'])
          || (from == 'on_the_way' && toStatus == 'delivered');
      }

      function validRiderAssignedOrderProgress() {
        let o = request.resource.data;
        let r = resource.data;
        let c = o.diff(r).affectedKeys();
        return isRider()
          && riderIsApproved()
          && isAssignedRiderForOrder()
          && o.riderId == r.riderId
          && o.assignedRiderId == r.assignedRiderId
          && orderCoreFieldsUnchanged()
          && o.openForRiders == false
          && o.status in ['picked_up', 'on_the_way', 'delivered']
          && riderDeliveryStatusTransitionOk(r.status, o.status)
          && c.hasOnly([
            'status', 'riderStatusUpdatedAt',
            'pickedUpAt', 'onTheWayAt', 'deliveredAt', 'updatedAt'
          ]);
      }

      function validAdminOrderCreate() {
        let o = request.resource.data;
        let addr = o.deliveryAddress;
        return o.customerId is string
          && o.customerId.size() > 0
          && o.customerId.size() <= 128
          && o.vendorId is string
          && o.vendorId.size() > 0
          && o.vendorId.size() <= 128
          && (!('vendorStoreId' in o)
            || (o.vendorStoreId is string
              && o.vendorStoreId.size() > 0
              && o.vendorStoreId.size() <= 128
              && o.vendorStoreId == o.vendorId))
          && o.storeName is string
          && o.storeName.size() > 0
          && o.storeName.size() <= 120
          && o.status is string
          && o.status.size() > 0
          && o.status.size() <= 32
          && o.paymentMethod is string
          && o.paymentMethod.size() > 0
          && o.paymentMethod.size() <= 32
          && o.items is list
          && o.items.size() > 0
          && o.items.size() <= 50
          && o.subtotal is int
          && o.subtotal >= 0
          && o.discount is int
          && o.discount >= 0
          && o.deliveryFee is int
          && o.deliveryFee >= 0
          && o.total is int
          && o.total >= 0
          && o.deliveryNote is string
          && o.deliveryNote.size() <= 500
          && o.specialInstructions is string
          && o.specialInstructions.size() <= 500
          && addr is map
          && addr.line1 is string
          && addr.line1.size() > 0
          && addr.line1.size() <= 200
          && addr.line2 is string
          && addr.line2.size() <= 200
          && addr.city is string
          && addr.city.size() > 0
          && addr.city.size() <= 80
          && addr.phone is string
          && addr.phone.size() >= 8
          && addr.phone.size() <= 20
          && (!('couponCode' in o)
            || (o.couponCode is string && o.couponCode.size() > 0 && o.couponCode.size() <= 32))
          && ((!('dropoffLatitude' in o) && !('dropoffLongitude' in o))
            || (o.dropoffLatitude is number && o.dropoffLongitude is number))
          && (!('trackingNumber' in o)
            || (o.trackingNumber is string
              && o.trackingNumber.matches('^MND[0-9]{2}[0-9]{5,12}$')));
      }

      function validOrderCreate() {
        let o = request.resource.data;
        let addr = o.deliveryAddress;
        return o.customerId is string
          && o.customerId == request.auth.uid
          && o.vendorId is string
          && o.vendorId.size() > 0
          && o.vendorId.size() <= 128
          && (!('vendorStoreId' in o)
            || (o.vendorStoreId is string
              && o.vendorStoreId.size() > 0
              && o.vendorStoreId.size() <= 128
              && o.vendorStoreId == o.vendorId))
          && o.storeName is string
          && o.storeName.size() > 0
          && o.storeName.size() <= 120
          && o.status == 'placed'
          && o.paymentMethod == 'cashOnDelivery'
          && o.items is list
          && o.items.size() > 0
          && o.items.size() <= 50
          && o.subtotal is int
          && o.subtotal >= 0
          && o.discount is int
          && o.discount >= 0
          && o.deliveryFee is int
          && o.deliveryFee >= 0
          && o.total is int
          && o.total >= 0
          && o.deliveryNote is string
          && o.deliveryNote.size() <= 500
          && o.specialInstructions is string
          && o.specialInstructions.size() <= 500
          && addr is map
          && addr.line1 is string
          && addr.line1.size() > 0
          && addr.line1.size() <= 200
          && addr.line2 is string
          && addr.line2.size() <= 200
          && addr.city is string
          && addr.city.size() > 0
          && addr.city.size() <= 80
          && addr.phone is string
          && addr.phone.size() >= 8
          && addr.phone.size() <= 20
          && (!('couponCode' in o)
            || (o.couponCode is string && o.couponCode.size() > 0 && o.couponCode.size() <= 32))
          && ((!('dropoffLatitude' in o) && !('dropoffLongitude' in o))
            || (o.dropoffLatitude is number && o.dropoffLongitude is number))
          && 'trackingNumber' in o
          && o.trackingNumber is string
          && o.trackingNumber.matches('^MND[0-9]{2}[0-9]{5,12}$');
      }

      allow read: if isAdmin() || isRider()
        || vendorMayAccessThisOrder()
        || isAssignedRiderForOrder()
        || (isSignedIn() && resource.data.customerId == request.auth.uid);

      allow create: if isSignedIn() && validOrderCreate()
        || (isAdmin() && validAdminOrderCreate());

      allow update: if isAdmin()
        || vendorMayAccessThisOrder()
        || validRiderClaimOrder()
        || validRiderAssignedOrderProgress()
        || (isSignedIn() && resource.data.customerId == request.auth.uid);

      allow delete: if isAdmin();
    }

    // Global counters (e.g. monotonic order sequence for `trackingNumber`).
    match /system/{docId} {
      allow read: if isSignedIn();

      allow create: if isSignedIn()
        && docId == 'order_sequence'
        && request.resource.data.keys().hasOnly(['value'])
        && request.resource.data.value is int
        && request.resource.data.value == 1;

      allow update: if isSignedIn()
        && docId == 'order_sequence'
        && request.resource.data.keys().hasOnly(['value'])
        && request.resource.data.value is int
        && request.resource.data.value == resource.data.value + 1;

      allow delete: if false;
    }

    // Notifications: owner reads own notifications.
    // Riders may create customer/vendor alerts when accepting a delivery.
    match /notifications/{notificationId} {
      function validRiderNotificationCreate() {
        let n = request.resource.data;
        return isRider()
          && n.userId is string
          && n.userId.size() > 0
          && n.userId.size() <= 128
          && n.orderId is string
          && n.orderId.size() > 0
          && n.orderId.size() <= 128
          && n.type is string
          && n.type == 'rider_accepted'
          && n.title is string
          && n.title.size() > 0
          && n.title.size() <= 120
          && n.body is string
          && n.body.size() > 0
          && n.body.size() <= 500
          && n.createdAt is timestamp
          && (!('read' in n) || n.read is bool);
      }

      allow read: if isSignedIn()
        && resource.data.userId == request.auth.uid;
      allow create: if isAdmin() || validRiderNotificationCreate();
      allow update, delete: if isAdmin();
    }

    // -------------------------------------------------------------------------
    // Jobs module (local employment listings — MND customer app)
    // -------------------------------------------------------------------------
    match /jobs/{jobId} {
      function validJobCreate() {
        let d = request.resource.data;
        return isSignedIn()
          && d.userId == request.auth.uid
          && d.status == 'pending'
          && d.title is string
          && d.title.size() >= 3
          && d.title.size() <= 120
          && d.category is string
          && d.category.size() > 0
          && d.type is string
          && d.type.size() > 0
          && d.salary is string
          && d.location is string
          && d.description is string
          && d.description.size() >= 10
          && d.companyName is string
          && d.companyName.size() > 0
          && d.contactPhone is string
          && d.contactPhone.size() >= 8
          && d.createdAt is timestamp
          && d.expiresAt is timestamp
          && (!('verified' in d) || d.verified is bool)
          && (!('urgent' in d) || d.urgent is bool)
          && (!('remote' in d) || d.remote is bool)
          && (!('availableLaborCount' in d)
            || (d.availableLaborCount is int
              && d.availableLaborCount >= 1
              && d.availableLaborCount <= 99));
      }

      function canReadJob() {
        return resource.data.status == 'active'
          || isAdmin()
          || (isSignedIn() && resource.data.userId == request.auth.uid);
      }

      // Public browse of approved listings; owners see their pending/rejected posts.
      allow read: if canReadJob();

      function validAdminJobCreate() {
        let d = request.resource.data;
        return isAdmin()
          && d.userId is string
          && d.userId.size() > 0
          && d.status in ['active', 'pending']
          && d.title is string
          && d.title.size() >= 3
          && d.title.size() <= 120
          && d.category is string
          && d.category.size() > 0
          && d.type is string
          && d.type.size() > 0
          && d.salary is string
          && d.location is string
          && d.description is string
          && d.description.size() >= 10
          && d.companyName is string
          && d.companyName.size() > 0
          && d.contactPhone is string
          && d.contactPhone.size() >= 8
          && d.createdAt is timestamp
          && d.expiresAt is timestamp
          && (!('availableLaborCount' in d)
            || (d.availableLaborCount is int
              && d.availableLaborCount >= 1
              && d.availableLaborCount <= 99));
      }

      allow create: if validJobCreate() || validAdminJobCreate();

      function ownerPendingJobPatchOk() {
        let c = request.resource.data.diff(resource.data).affectedKeys();
        return isSignedIn()
          && resource.data.userId == request.auth.uid
          && resource.data.status == 'pending'
          && request.resource.data.userId == resource.data.userId
          && request.resource.data.status == 'pending'
          && (
            c.hasOnly(['imageUrl', 'logoUrl'])
            || c.hasOnly(['imageUrl'])
            || c.hasOnly(['logoUrl'])
          );
      }

      allow update: if isAdmin()
        || ownerPendingJobPatchOk()
        || (isSignedIn()
          && resource.data.userId == request.auth.uid
          && resource.data.status == 'pending'
          && request.resource.data.userId == resource.data.userId
          && request.resource.data.status == 'pending');

      allow delete: if isAdmin()
        || (isSignedIn() && resource.data.userId == request.auth.uid);
    }

    match /job_applications/{applicationId} {
      function jobDocForApplication(jobId) {
        return get(/databases/$(database)/documents/jobs/$(jobId));
      }

      function isJobOwnerForApplication(jobId) {
        return isSignedIn()
          && jobId is string
          && jobId.size() > 0
          && jobId.size() <= 128
          && exists(/databases/$(database)/documents/jobs/$(jobId))
          && jobDocForApplication(jobId).data.userId == request.auth.uid;
      }

      function validJobApplicationCreate() {
        let d = request.resource.data;
        return isSignedIn()
          && d.applicantId == request.auth.uid
          && d.jobId is string
          && d.jobId.size() > 0
          && d.applicantName is string
          && d.applicantPhone is string
          && d.applicantPhone.size() >= 8
          && d.status == 'submitted'
          && d.appliedAt is timestamp
          && isJobOwnerForApplication(d.jobId) == false;
      }

      function validEmployerApplicationUpdate() {
        let c = request.resource.data.diff(resource.data).affectedKeys();
        return isJobOwnerForApplication(resource.data.jobId)
          && request.resource.data.applicantId == resource.data.applicantId
          && request.resource.data.jobId == resource.data.jobId
          && request.resource.data.status in ['submitted', 'shortlisted', 'booked', 'rejected']
          && (
            c.hasOnly(['status', 'updatedAt'])
            || c.hasOnly(['status', 'updatedAt', 'bookedAt'])
          );
      }

      allow read: if isAdmin()
        || (isSignedIn() && resource.data.applicantId == request.auth.uid)
        || isJobOwnerForApplication(resource.data.jobId);

      allow create: if validJobApplicationCreate();
      allow update: if isAdmin() || validEmployerApplicationUpdate();
      allow delete: if isAdmin();
    }

    match /saved_jobs/{docId} {
      allow read: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow create: if isSignedIn()
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.jobId is string
        && request.resource.data.savedAt is timestamp;
      allow delete: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow update: if false;
    }

    match /job_reports/{reportId} {
      allow read: if isAdmin();
      allow create: if isSignedIn()
        && request.resource.data.reporterId == request.auth.uid
        && request.resource.data.jobId is string
        && request.resource.data.reason is string
        && request.resource.data.createdAt is timestamp;
      allow update, delete: if isAdmin();
    }

    // Customer → shop ratings (one doc per delivered order; doc id == orderId).
    match /store_ratings/{orderId} {
      function storeRatingOrder() {
        return get(/databases/$(database)/documents/orders/$(orderId)).data;
      }

      function storeRatingOrderExists() {
        return exists(/databases/$(database)/documents/orders/$(orderId));
      }

      function validStoreRatingCreate() {
        let d = request.resource.data;
        let o = storeRatingOrder();
        return isSignedIn()
          && storeRatingOrderExists()
          && d.orderId == orderId
          && d.customerId == request.auth.uid
          && o.customerId == request.auth.uid
          && o.status == 'delivered'
          && (!('storeRated' in o) || o.storeRated != true)
          && d.vendorId is string
          && d.vendorId.size() > 0
          && d.vendorId.size() <= 128
          && d.vendorId == o.vendorId
          && d.storeName is string
          && d.storeName.size() > 0
          && d.storeName.size() <= 120
          && d.stars is int
          && d.stars >= 1
          && d.stars <= 5
          && d.comment is string
          && d.comment.size() <= 500
          && d.status == 'visible'
          && d.createdAt is timestamp
          && d.updatedAt is timestamp;
      }

      allow read: if isAdmin()
        || (isSignedIn() && resource.data.customerId == request.auth.uid)
        || (isSignedIn() && resource.data.status == 'visible');

      allow create: if validStoreRatingCreate();

      allow update: if isAdmin()
        && request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['status', 'updatedAt'])
        && request.resource.data.status in ['visible', 'hidden']
        && request.resource.data.updatedAt is timestamp;

      allow delete: if isAdmin();
    }

    // Device tokens: owner manages own token docs (FCM registry).
    match /device_tokens/{tokenId} {
      function validDeviceTokenWrite() {
        let d = request.resource.data;
        return d.userId == request.auth.uid
          && d.token is string
          && d.token.size() >= 20
          && d.token.size() <= 4096
          && d.platform is string
          && d.platform.size() > 0
          && d.platform.size() <= 32
          && d.app is string
          && d.app in ['mnd_rider', 'mnd_customer', 'mnd_shop', 'mnd_web']
          && (!('role' in d) || d.role is string);
      }

      allow read: if isSignedIn()
        && resource.data.userId == request.auth.uid;
      allow create, update: if isSignedIn() && validDeviceTokenWrite();
      allow delete: if isSignedIn()
        && resource.data.userId == request.auth.uid;
    }
  }
}
