rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // Shop app uploads product images here; customer app reads for catalogue.
    match /vendor_products/{storeId}/{allPaths=**} {
      allow read: if request.auth != null;
      allow write: if request.auth != null
        && request.resource.size < 10 * 1024 * 1024;
    }

    // Shop registration / storefront gallery (same auth requirement as product uploads).
    match /vendor_storefront/{storeId}/{allPaths=**} {
      allow read: if request.auth != null;
      allow write: if request.auth != null
        && request.resource.size < 10 * 1024 * 1024;
    }

    // MND Jobs module: listing banner/logo and applicant CVs.
    match /jobs/{jobId}/{allPaths=**} {
      allow read: if request.auth != null;
      allow write: if request.auth != null
        && request.resource.size > 0
        && request.resource.size < 10 * 1024 * 1024;
    }

    match /job_applications/{userId}/{allPaths=**} {
      allow read: if request.auth != null
        && request.auth.uid == userId;
      allow write: if request.auth != null
        && request.auth.uid == userId
        && request.resource.size > 0
        && request.resource.size < 10 * 1024 * 1024;
    }

    // Rider app: profile + license photos (`riders/{uid}/profile.jpg`, etc.).
    match /riders/{riderId}/{allPaths=**} {
      function isRiderOwner() {
        return request.auth != null && request.auth.uid == riderId;
      }

      function isRiderImageUpload() {
        return request.resource.size > 0
          && request.resource.size < 10 * 1024 * 1024
          && request.resource.contentType.matches('image/(jpeg|jpg|png|webp)');
      }

      allow read: if request.auth != null;
      allow write: if isRiderOwner() && isRiderImageUpload();
      allow delete: if isRiderOwner();
    }
  }
}
