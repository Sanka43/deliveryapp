{
  "hosting": {
    "public": ".",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**",
      "public/**",
      ".agents/**",
      ".windsurf/**",
      "README.md",
      "skills-lock.json"
    ],
    "headers": [
      {
        "source": "favicon.ico",
        "headers": [{ "key": "Cache-Control", "value": "public,max-age=604800" }]
      },
      {
        "source": "**/*.@(js|css)",
        "headers": [{ "key": "Cache-Control", "value": "no-cache" }]
      }
    ]
  }
}
